{
  "name": "Ricochet",
  "scopeName": "source.ricochet",
  "fileTypes": [
    "rco"
  ],
  "firstLineMatch": "(?:^#!.*\\brco\\b|^\\s*\\(\\(.*Ricochet)",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#references"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#mutator-words"
    },
    {
      "include": "#route-verbs"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#async"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.ricochet",
          "begin": "\\(\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.ricochet"
            }
          },
          "end": "\\)\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.ricochet"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ricochet",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ricochet"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ricochet"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ricochet",
              "match": "\\\\[\"\\\\nrt]"
            },
            {
              "name": "invalid.illegal.escape.ricochet",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "variable.other.read.ricochet",
          "match": "(?<!\\S)(\\$)([^\\s()\\[\\]]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.ricochet"
            },
            "2": {
              "name": "variable.other.ricochet"
            }
          }
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "entity.name.function.selector.ricochet",
          "match": "(?<!\\S)([A-Za-z_][A-Za-z0-9_-]*)(\\.)([A-Za-z_][A-Za-z0-9_!?-]*)(?!\\S)",
          "captures": {
            "1": {
              "name": "variable.other.receiver.ricochet"
            },
            "2": {
              "name": "punctuation.accessor.dot.ricochet"
            },
            "3": {
              "name": "entity.name.function.selector.ricochet"
            }
          }
        }
      ]
    },
    "mutator-words": {
      "patterns": [
        {
          "name": "support.function.mutator.ricochet",
          "match": "(?<!\\S)(?:push|put|insert_at|remove|remove_at|clear_items)(?!\\S)"
        }
      ]
    },
    "route-verbs": {
      "patterns": [
        {
          "name": "constant.language.http-method.ricochet",
          "match": "(?<!\\S)(?:GET|POST|PUT|PATCH|DELETE)(?!\\S)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ricochet",
          "match": "(?<!\\S)(?:true|false)(?!\\S)"
        },
        {
          "name": "constant.language.nil.ricochet",
          "match": "(?<!\\S)nil(?!\\S)"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.ricochet",
          "match": "(?<!\\S)(?:if|else|while|end|return|break|continue)(?!\\S)"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.ricochet",
          "match": "(?<!\\S)(?:Subclass|Field|Accessor|Table|Method|function|var|array|list|map|route|import)(?!\\S)"
        }
      ]
    },
    "async": {
      "patterns": [
        {
          "name": "keyword.control.async.ricochet",
          "match": "(?<!\\S)(?:spawn|await|await_all|release_task|tasks)(?!\\S)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.ricochet",
          "match": "(?<!\\S)(?:\\+|-|\\*|/|%)(?!\\S)"
        },
        {
          "name": "keyword.operator.comparison.ricochet",
          "match": "(?<!\\S)(?:!=|<=|>=|=|<|>)(?!\\S)"
        },
        {
          "name": "punctuation.separator.return-type.ricochet",
          "match": "->"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.word.ricochet",
          "match": "(?<!\\S)(?:add|subtract|multiply|divide|modulo|negate|abs|min|max|clamp|not|and|or|equals|not_equals\\?|less_than\\?|greater_than\\?|less_or_equals\\?|greater_or_equals\\?|assert|assert_true|assert_false|assert_ok|assert_error|assert_equals|self|get|set|new|send|call|value|error|ok|fail|swap|dup|drop|over|rot|nip|tuck|pick|roll|depth|clear|println|inspect|debug|print|eprint|read_line|args|env|env_get|env_set|secret_env|secret_literal|secret_resolve|password_hash|password_verify|config_get|cwd|now|timestamp_now|timestamp_parse|timestamp_format|timestamp_format_pattern|timestamp_parts|timestamp_from_parts|timestamp_add|timestamp_diff|date_from_timestamp|date_to_timestamp|date_parse|date_format|date_add_days|date_diff_days|duration_millis|duration_seconds|duration_minutes|duration_hours|duration_days|duration_weeks|duration_parts|sleep|random|exit|view|text|json|redirect|status|header|range|regex|to_string|to_number|to_integer|to_bigint|to_int|to_mediumint|to_smallint|to_tinyint|to_bit|to_unsigned_int|to_unsigned_mediumint|to_unsigned_smallint|to_unsigned_tinyint|to_unsigned_bigint|to_float|to_float32|to_float64|to_double|to_real|json_encode|json_decode|type|class_of|instance_of\\?|responds_to\\?|fields|methods|callable\\?|at|count|count_records|first|first_record|last|take|skip|reverse|has\\?|keys|values|each|transform|select|reduce|find|find_record|default_page|limit|where|update|any\\?|all\\?|join|trim|trim_start|trim_end|blank\\?|slice|index_of|last_index_of|repeat|lines|chars|split|replace|contains\\?|starts_with\\?|ends_with\\?|uppercase|lowercase|concat|matches\\?|regex_find|regex_replace|captures|ok\\?|nil\\?|empty\\?|error\\?|unwrap_or|map_result|and_then|result_envelope|runtime_capabilities|id|info|task_status|pending\\?|running\\?|completed\\?|failed\\?|fs_read_text|fs_write_text|fs_exists\\?|fs_list|fs_create_dir|fs_delete|workspace_resolve|workspace_contains\\?|workspace_metadata|workspace_list|workspace_read_text|workspace_write_text|workspace_mkdir|workspace_delete|workspace_copy|workspace_move|http_request_new|http_header_put|http_bearer_auth|http_json_body|http_timeout|http_get|http_post_json|http_request|http_get_task|http_post_json_task|http_request_task|http_stream_start|http_streams|http_stream|http_stream_read|http_stream_cancel|http_stream_release|upload_streams|upload_stream|upload_read|upload_release|tcp_listen|tcp_listeners|tcp_listener|tcp_accept|tcp_listener_close|tcp_listener_release|tcp_connect|tcp_connections|tcp_connection|tcp_write|tcp_read|tcp_close|tcp_release|ws_listen|ws_listeners|ws_listener|ws_accept|ws_listener_close|ws_listener_release|ws_connect|ws_connections|ws_connection|ws_send|ws_read|ws_close|ws_release|process_spawn|process_spawn_task|process_start|process_jobs|process_job|process_cancel|process_release|process_write|process_read|process_env_put|pty_start|pty_write|pty_read|pty_resize|pty_stop|pty_release|pty_list|pty_detail|approval_create|approval_claim|approval_complete|approval_reject|approval_detail|approval_release|tui_enter|tui_leave|tui_clear|tui_move_to|tui_write|tui_flush|tui_size|tui_poll_key|tui_read_key|webview_text|webview_heading|webview_button|web_command|web_command_button|webview_action|webview_input|webview_link|webview_container|web_toolbar|web_sidebar|web_tabs|web_split_pane|web_table|web_form_row|web_status_bar|web_menu|web_menu_bar|webview_window|webview_window_state|webview_window_app|webview_open_file|webview_save_file|webview_choose_folder|webview_clipboard_read|webview_clipboard_write|webview_open_url|webview_document)(?!\\S)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.class.ricochet",
          "match": "(?<!\\S)(?:Object|Model|Controller|Result|Array|List|Map|Set|Float)(?!\\S)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ricochet",
          "match": "(?<!\\S)-?(?:\\d+\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+)(?!\\S)"
        },
        {
          "name": "constant.numeric.integer.ricochet",
          "match": "(?<!\\S)-?\\d+(?!\\S)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.ricochet",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.arguments.ricochet",
          "match": "[()]"
        }
      ]
    }
  }
}
