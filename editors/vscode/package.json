{
  "name": "ricochet-language",
  "displayName": "Ricochet Language",
  "description": "Syntax highlighting and language-server support for Ricochet .rco files.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "ricochet",
  "engines": {
    "vscode": "^1.84.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace Ricochet executable settings are ignored until the workspace is trusted."
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ricochet",
    "onCommand:ricochet.runWithStackVisualizer",
    "onCommand:ricochet.showDebuggerStack",
    "onDebugResolve:ricochet"
  ],
  "categories": [
    "Programming Languages"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "configuration": {
      "title": "Ricochet",
      "properties": {
        "ricochet.server.path": {
          "type": "string",
          "default": "rco",
          "description": "Path to the Ricochet CLI executable used to launch `rco lsp` and `rco debug-adapter`."
        },
        "ricochet.server.trace": {
          "type": "boolean",
          "default": false,
          "description": "Trace Ricochet LSP JSON-RPC messages to the extension host log."
        }
      }
    },
    "commands": [
      {
        "command": "ricochet.restartLanguageServer",
        "title": "Ricochet: Restart Language Server"
      },
      {
        "command": "ricochet.runWithStackVisualizer",
        "title": "Ricochet: Run With Stack Visualizer"
      },
      {
        "command": "ricochet.showDebuggerStack",
        "title": "Ricochet: Show Debugger Stack"
      }
    ],
    "debuggers": [
      {
        "type": "ricochet",
        "label": "Ricochet",
        "languages": [
          "ricochet"
        ],
        "configurationAttributes": {
          "launch": {
            "type": "object",
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Ricochet .rco file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the Ricochet program.",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ricochet",
            "request": "launch",
            "name": "Debug Ricochet File",
            "program": "${file}",
            "args": []
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "ricochet",
        "aliases": [
          "Ricochet",
          "ricochet"
        ],
        "extensions": [
          ".rco"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ricochet",
        "scopeName": "source.ricochet",
        "path": "./syntaxes/ricochet.tmLanguage.json"
      }
    ]
  }
}
