"../session" import

AuthPackageTest TestCase Subclass
  [
    session map
    session get "user_id" "ada" put! drop
    session get auth_user_present
    true assert-equals
  ] "testUserPresent" Method
  [
    session map
    session get "user_id" "ada" put! drop
    session get "/login" auth_route_guard guard var
    guard get "ok" at
    true assert-equals
    guard get "reason" at
    nil assert-equals
  ] "testRouteGuardAllowsAuthenticatedSession" Method
  [
    session map
    session get "/login" auth_route_guard guard var
    guard get "ok" at
    false assert-equals
    guard get "redirect" at
    "/login" assert-equals
    guard get "reason" at
    "missing_user_session" assert-equals
  ] "testRouteGuardRejectsMissingSession" Method
  [
    session map
    session get "csrf_token" "abc" put! drop
    session get "abc" auth_csrf_valid
    true assert-equals
  ] "testCsrfValid" Method
  [
    session map
    session get "" auth_csrf_valid
    false assert-equals
  ] "testCsrfRejectsMissingStoredToken" Method
  [
    session map
    session get "csrf_token" "" put! drop
    session get "" auth_csrf_valid
    false assert-equals
  ] "testCsrfRejectsBlankTokens" Method
  [
    session map
    session get "csrf_token" "abc" put! drop
    session get "wrong" auth_csrf_check "reason" at
    "invalid_csrf_token" assert-equals
  ] "testCsrfCheckReason" Method
  [
    "ada" "token" auth_session_for_user session var
    session get "user_id" at
    "ada" assert-equals
    session get "authenticated" at
    true assert-equals
  ] "testSessionForUser" Method
  [
    auth_secure_cookie_options options var
    options get "http_only" at
    true assert-equals
    options get "same_site" at
    "Lax" assert-equals
  ] "testSecureCookieOptions" Method
end
