"../session" import

AuthPackageTest TestCase Subclass
  [
    session map
    $session "user_id" "ada" put drop
    $session auth_user_present
    true assert_equals
  ] "testUserPresent" Method
  [
    session map
    $session "user_id" "ada" put drop
    $session "/login" auth_route_guard guard var
    $guard "ok" at
    true assert_equals
    $guard "reason" at
    nil assert_equals
  ] "testRouteGuardAllowsAuthenticatedSession" Method
  [
    session map
    $session "/login" auth_route_guard guard var
    $guard "ok" at
    false assert_equals
    $guard "redirect" at
    "/login" assert_equals
    $guard "reason" at
    "missing_user_session" assert_equals
  ] "testRouteGuardRejectsMissingSession" Method
  [
    session map
    $session "csrf_token" "abc" put drop
    $session "abc" auth_csrf_valid
    true assert_equals
  ] "testCsrfValid" Method
  [
    session map
    $session "" auth_csrf_valid
    false assert_equals
  ] "testCsrfRejectsMissingStoredToken" Method
  [
    session map
    $session "csrf_token" "" put drop
    $session "" auth_csrf_valid
    false assert_equals
  ] "testCsrfRejectsBlankTokens" Method
  [
    session map
    $session "csrf_token" "abc" put drop
    $session "wrong" auth_csrf_check "reason" at
    "invalid_csrf_token" assert_equals
  ] "testCsrfCheckReason" Method
  [
    "ada" "token" auth_session_for_user session var
    $session "user_id" at
    "ada" assert_equals
    $session "authenticated" at
    true assert_equals
  ] "testSessionForUser" Method
  [
    auth_secure_cookie_options options var
    $options "http_only" at
    true assert_equals
    $options "same_site" at
    "Lax" assert_equals
  ] "testSecureCookieOptions" Method
  [
    " ADA@Example.COM " auth_credential_normalize
    "ada@example.com" assert_equals
  ] "testCredentialNormalize" Method
  [
    " ada@example.com " auth_credential_validate result var
    $result "ok" at
    true assert_equals
    $result "credential" at
    "ada@example.com" assert_equals
  ] "testCredentialValidateAcceptsNormalizedIdentifier" Method
  [
    "bad user" auth_credential_validate result var
    $result "ok" at
    false assert_equals
    $result "reason" at
    "credential_whitespace" assert_equals
  ] "testCredentialValidateRejectsWhitespace" Method
  [
    auth_password_policy policy var
    $policy "storage" at
    "argon2id" assert_equals
    $policy "min_length" at
    12 assert_equals
  ] "testPasswordPolicy" Method
  [
    "ada@example.com" "Long unique passphrase 2026" auth_password_validate result var
    $result "ok" at
    true assert_equals
  ] "testPasswordValidateAcceptsPassphrase" Method
  [
    "ada@example.com" "short" auth_password_validate result var
    $result "ok" at
    false assert_equals
    $result "reason" at
    "password_too_short" assert_equals
  ] "testPasswordValidateRejectsShortPassword" Method
  [
    "ada@example.com" "ada@example.com has a long password" auth_password_validate result var
    $result "ok" at
    false assert_equals
    $result "reason" at
    "password_contains_credential" assert_equals
  ] "testPasswordValidateRejectsCredentialSubstring" Method
  [
    "ada@example.com" "welcome123456" auth_password_validate result var
    $result "ok" at
    false assert_equals
    $result "reason" at
    "password_common" assert_equals
  ] "testPasswordValidateRejectsCommonPassword" Method
  [
    "ada@example.com" "Long unique passphrase 2026" auth_password_hash assert_ok
  ] "testPasswordHashAcceptsValidPolicy" Method
  [
    "ada@example.com" "short" auth_password_hash error "kind" at
    "PasswordPolicyError" assert_equals
  ] "testPasswordHashRejectsInvalidPolicy" Method
  [
    "ada@example.com" "Long unique passphrase 2026" auth_password_hash value hash var
    "Long unique passphrase 2026" $hash auth_password_verify verification var
    $verification "ok" at
    true assert_equals
    $verification "authenticated" at
    true assert_equals
  ] "testPasswordVerifyAcceptsMatchingPassword" Method
  [
    "ada@example.com" "Long unique passphrase 2026" auth_password_hash value hash var
    "Wrong unique passphrase 2026" $hash auth_password_verify verification var
    $verification "ok" at
    true assert_equals
    $verification "authenticated" at
    false assert_equals
    $verification "reason" at
    "password_mismatch" assert_equals
  ] "testPasswordVerifyRejectsMismatch" Method
  [
    "Long unique passphrase 2026" "not-a-hash" auth_password_verify verification var
    $verification "ok" at
    false assert_equals
    $verification "reason" at
    "PasswordHashError" assert_equals
  ] "testPasswordVerifyRejectsInvalidHash" Method
  [
    "Ada@Example.COM" "Long unique passphrase 2026" auth_password_hash value hash var
    " ada@example.com " "Long unique passphrase 2026" "ada@example.com" $hash auth_credentials_verify verification var
    $verification "ok" at
    true assert_equals
    $verification "authenticated" at
    true assert_equals
  ] "testCredentialsVerifyAcceptsNormalizedCredentialAndPassword" Method
  [
    "ada@example.com" "Long unique passphrase 2026" auth_password_hash value hash var
    "grace@example.com" "Long unique passphrase 2026" "ada@example.com" $hash auth_credentials_verify verification var
    $verification "ok" at
    true assert_equals
    $verification "authenticated" at
    false assert_equals
    $verification "reason" at
    "invalid_credentials" assert_equals
  ] "testCredentialsVerifyRejectsCredentialMismatch" Method
end
