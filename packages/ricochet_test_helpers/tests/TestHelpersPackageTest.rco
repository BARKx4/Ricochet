"../assertions" import

TestHelpersPackageTest TestCase Subclass
  [
    "Ada" "Ada" test_assert_equal
    "Ada" assert_equals
  ] "testAssertEqualReturnsActual" Method
  [
    response map
    $response "status" 200 put drop
    $response test_http_ok
    true assert_equals
  ] "testHttpOk" Method
