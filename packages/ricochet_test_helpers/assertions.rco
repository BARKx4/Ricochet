(( Test assertion and fixture helper words. ))
( expected actual -> Value ) test_assert_equal function
  actual var
  expected var
  $actual $expected assert-equals
  $actual
end

( subject key expected -> Map ) test_assert_map_field function
  expected var
  key var
  subject var
  $subject $key at $expected assert-equals
  $subject
end

( response -> Bool ) test_http_ok function
  response var
  $response "status" at 200 =
end

( response expected -> Map ) test_http_assert_status function
  expected var
  response var
  $response "status" at $expected assert-equals
  $response
end

( value name -> Map ) test_fixture function
  name var
  value var
  fixture map
  $fixture "name" $name put! drop
  $fixture "value" $value put! drop
  $fixture
end

( name -> Map ) test_workspace function
  name var
  workspace map
  $workspace "name" $name put! drop
  $workspace "root" ".tmp/" $name concat put! drop
  $workspace
end
