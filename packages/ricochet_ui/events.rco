(( Portable UI event helpers. ))
( type id value -> Map ) ui_event function
  value var
  id var
  type var
  event map
  $event "schema_version" 1 put drop
  $event "type" $type put drop
  $event "id" $id put drop
  $event "value" $value put drop
  $event
end

( event -> Bool ) ui_click_event? function
  event var
  $event "type" at "click" =
end

( event -> Bool ) ui_change_event? function
  event var
  $event "type" at "change" =
end

( event -> Bool ) ui_drop_event? function
  event var
  $event "type" at "drop" =
end
