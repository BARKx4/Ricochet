( id columns rows children -> Map ) ui_grid function
  children var
  rows var
  columns var
  id var
  props map
  $props "columns" $columns put! drop
  $props "rows" $rows put! drop
  events array
  native map
  $id "grid" $props $children $events $native ui_node
