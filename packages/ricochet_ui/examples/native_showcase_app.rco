"../document" import
"../events" import
"../commands" import
"../rich_text" import

( -> Map ) app_init function
  state map
  $state "ready_score" 82 put drop
  $state "reviewed_items" 3 put drop
  $state "selected_area" "winui_host" put drop
  $state
end

( -> Map ) build_command_bar function
  items array
  $items "mark_docs_reviewed" "Mark reviewed" "Ctrl+R" ui_command_item push drop
  $items "focus_notes" "Focus notes" "Ctrl+N" ui_command_item push drop
  $items "copy_summary" "Copy summary" "Ctrl+Shift+C" ui_command_item push drop
  "release_command_bar" $items ui_command_bar
end

( -> Map ) build_release_tree function
  hostChildren array
  emptyA array
  $hostChildren "node-host-project" "WinUI host project" $emptyA ui_tree_node push drop
  emptyB array
  $hostChildren "node-host-protocol" "JSONL event protocol" $emptyB ui_tree_node push drop
  "node-winui-host" "WinUI host" $hostChildren ui_tree_node hostNode var

  docsChildren array
  emptyC array
  $docsChildren "node-reference" "Reference catalog" $emptyC ui_tree_node push drop
  emptyD array
  $docsChildren "node-acceptance" "Acceptance checks" $emptyD ui_tree_node push drop
  "node-docs" "Docs and release notes" $docsChildren ui_tree_node docsNode var

  packageChildren array
  emptyE array
  $packageChildren "node-rco-app" "rco-app launcher" $emptyE ui_tree_node push drop
  "node-packaging" "Packaging" $packageChildren ui_tree_node packageNode var

  "tree_nodes" "node-packaging" ui_drag_payload payload var
  operations array
  $operations "move" push drop
  $packageNode $payload $operations ui_drag_source draggablePackage var

  accepts array
  $accepts "tree_nodes" push drop
  $docsNode $accepts $operations ui_drop_target dropDocs var

  nodes array
  $nodes $hostNode push drop
  $nodes $dropDocs push drop
  $nodes $draggablePackage push drop
  expanded array
  $expanded "node-winui-host" push drop
  $expanded "node-docs" push drop
  selected array
  $selected "node-winui-host" push drop
  "release_tree" $nodes $expanded $selected ui_tree
end

( -> Map ) build_release_grid function
  columns array
  $columns "area" "Area" "string" "2*" ui_grid_column push drop
  $columns "status" "Status" "string" "1*" ui_grid_column push drop
  $columns "next" "Next action" "string" "3*" ui_grid_column push drop

  hostCells map
  $hostCells "area" "WinUI host" put drop
  $hostCells "status" "Green" put drop
  $hostCells "next" "Validate self-contained host on clean Windows" put drop
  "winui_host" $hostCells ui_grid_row hostRow var

  packageCells map
  $packageCells "area" "Packaging" put drop
  $packageCells "status" "Watch" put drop
  $packageCells "next" "Bundle host output with release archives" put drop
  "packaging" $packageCells ui_grid_row packageRow var

  docsCells map
  $docsCells "area" "Docs" put drop
  $docsCells "status" "Green" put drop
  $docsCells "next" "Keep native UI examples visible in reference docs" put drop
  "docs" $docsCells ui_grid_row docsRow var

  showcaseCells map
  $showcaseCells "area" "Showcase app" put drop
  $showcaseCells "status" "New" put drop
  $showcaseCells "next" "Use this app for release candidate demos" put drop
  "showcase" $showcaseCells ui_grid_row showcaseRow var

  rows array
  $rows $hostRow push drop
  $rows $packageRow push drop
  $rows $docsRow push drop
  $rows $showcaseRow push drop
  selected array
  $selected "winui_host" push drop
  "release_grid" $columns $rows $selected ui_data_grid
end

( -> Map ) build_release_notes function
  titleMarks array
  $titleMarks "bold" push drop
  titleSpans array
  $titleSpans "Release candidate desk" $titleMarks nil ui_rich_span push drop

  bodySpans array
  bodyMarks array
  $bodySpans "Use this native app to review WinUI host readiness, package bundling, docs, and demo confidence before cutting a release candidate." $bodyMarks nil ui_rich_span push drop

  linkMarks array
  $linkMarks "italic" push drop
  linkSpans array
  $linkSpans "Focus the notes, copy a summary, or mark a row reviewed from the command bar." $linkMarks nil ui_rich_span push drop

  blocks array
  $blocks $titleSpans ui_rich_paragraph push drop
  $blocks $bodySpans ui_rich_paragraph push drop
  $blocks $linkSpans ui_rich_paragraph push drop
  $blocks ui_rich_document doc var
  "release_notes" "Release notes" $doc ui_rich_text_input
end

( state -> Map ) build_summary_panel function
  state var
  children array
  $children "ready_score" "Ship confidence: " $state "ready_score" at to_string concat "%" concat ui_text push drop
  $children "reviewed_items" "Reviewed items: " $state "reviewed_items" at to_string concat ui_text push drop
  $children "selected_area" "Selected area: " $state "selected_area" at concat ui_text push drop
  "summary_group" "Release summary" $children ui_group
end

( state -> Map ) build_workspace function
  state var
  leftChildren array
  $leftChildren build_release_tree push drop
  "scope_group" "Release scope" $leftChildren ui_group leftPane var

  rightChildren array
  build_release_grid releaseGrid var
  build_release_notes notesEditor var
  $rightChildren $releaseGrid push drop
  $rightChildren $notesEditor push drop
  "detail_stack" "vertical" $rightChildren ui_stack rightStack var
  rightGroupChildren array
  $rightGroupChildren $rightStack push drop
  "detail_group" "Readiness details" $rightGroupChildren ui_group rightPane var

  "workspace_split" "horizontal" $leftPane $rightPane ui_split_pane
end

( state -> Map ) app_view function
  state var
  children array
  $children build_command_bar push drop
  $children $state build_summary_panel push drop
  $children $state build_workspace push drop
  "main" "Native Release Desk" $children ui_window value
end

( state event -> Map ) app_update function
  event var
  state var
  commands array

  $event ui_click_event? if
    $event "id" at "mark_docs_reviewed" = if
      $state "reviewed_items" at 1 + reviewed var
      $state "ready_score" at 3 + score var
      $state "reviewed_items" $reviewed put drop
      $state "ready_score" $score put drop
    end
    $event "id" at "focus_notes" = if
      $commands "release_notes" ui_focus push drop
    end
    $event "id" at "copy_summary" = if
      $commands "Native Release Desk summary copied" ui_clipboard_write push drop
    end
  end

  $state app_view document var
  $state $document $commands ui_response value
end

app_init state var
$state app_view document var
$document "type" at "window" assert_equals
$document "props" at "title" at "Native Release Desk" assert_equals
$document "children" at count 3 assert_equals
$document "children" at first "id" at "release_command_bar" assert_equals
$document "children" at 1 at "children" at first "props" at "text" at "Ship confidence: 82%" assert_equals

"click" "mark_docs_reviewed" nil ui_event reviewEvent var
$state $reviewEvent app_update reviewResponse var
$reviewResponse "state" at "ready_score" at 85 assert_equals
$reviewResponse "state" at "reviewed_items" at 4 assert_equals
$reviewResponse "document" at "children" at 1 at "children" at first "props" at "text" at "Ship confidence: 85%" assert_equals

"click" "focus_notes" nil ui_event focusEvent var
$reviewResponse "state" at $focusEvent app_update focusResponse var
$focusResponse "commands" at first "type" at "focus" assert_equals
$focusResponse "commands" at first "target" at "release_notes" assert_equals
