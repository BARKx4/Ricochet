"../document" import

"../events" import

"../commands" import

( -> Map ) app_init function
  state map
  $state "count" 0 put drop
  $state
end

( state -> Map ) app_view function
  state var
  children array
  $children "count_label" "Count: " $state "count" at to_string concat ui_text push drop
  $children "increment_button" "Increment" ui_button push drop
  "main" "Counter" $children ui_window value
end

( state event -> Map ) app_update function
  event var
  state var
  $event ui_click_event? if
    $event "id" at "increment_button" = if
      $state "count" at 1 + nextCount var
      $state "count" $nextCount put drop
    end
  end
  $state app_view document var
  commands array
  $state $document $commands ui_response value
end

app_init state var
$state app_view document var
$document "type" at "window" assert_equals
$document "children" at count 2 assert_equals
"click" "increment_button" nil ui_event event var
$state $event app_update response var
$response "state" at "count" at 1 assert_equals
$response "document" at "children" at first "props" at "text" at "Count: 1" assert_equals
