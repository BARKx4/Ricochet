"./protocol" import

(( Retained-process Python worker management. ))
( workerDir -> String ) py_worker_script_path function
  workerDir var
  $workerDir "/ricochet_python_bridge.py" concat
end

( modulePath env -> Map ) py_worker_options function
  env var
  modulePath var
  options map
  envMap map
  $env nil? false = if
    $env envMap set
  end
  $modulePath nil? false = if
    $modulePath blank? false = if
      $envMap "PYTHONPATH" $modulePath put drop
    end
  end
  $options "stdin_open" true put drop
  $options "stdout_max_bytes" 1048576 put drop
  $options "stderr_max_bytes" 262144 put drop
  $options "timeout_ms" 300000 put drop
  $options "env" $envMap put drop
  $options
end

( python workerDir modulePath env -> Result ) py_worker_start function
  env var
  modulePath var
  workerDir var
  python var
  args array
  $args $workerDir py_worker_script_path push drop
  $modulePath $env py_worker_options options var
  $python $args $options process_start startResult var
  $startResult ok? if
    $startResult value snapshot var
    worker map
    $worker "job_id" $snapshot "id" at put drop
    $worker "stdout_offset" 0 put drop
    $worker "stderr_offset" 0 put drop
    $worker "stdout_buffer" "" put drop
    $worker "next_id" 1 put drop
    $worker "python" $python put drop
    $worker "worker_dir" $workerDir put drop
    $worker "module_path" $modulePath put drop
    $worker ok
  else
    $startResult
  end
end

( worker -> Number ) py_worker_next_id function
  worker var
  $worker "next_id" at current var
  $worker "next_id" $current 1 + put drop
  $current
end

( worker read -> Map ) py_worker_commit_read function
  read var
  worker var
  $worker "stdout_offset" $read "stdout_offset" at put drop
  $worker "stderr_offset" $read "stderr_offset" at put drop
  $worker
end

( line expectedId -> Result ) py_worker_decode_line function
  expectedId var
  line var
  $line trim cleanLine var
  $cleanLine json_decode decoded var
  $decoded ok? if
    $decoded value response var
    $response "id" at $expectedId = if
      $response py_response_to_result
    else
      "PythonBridgeProtocolError" "Python worker returned a response for a different request id" fail
    end
  else
    "PythonBridgeProtocolError" "Python worker returned invalid JSON" fail
  end
end

( worker request -> Result ) py_worker_exchange function
  request var
  worker var
  $request py_request_line line var
  $worker "job_id" at $line process_write writeResult var
  nil finalResult var
  $writeResult ok? false = if
    $writeResult finalResult set
  else
    0 attempts var
    $finalResult nil? $attempts 200 < and while
      readOptions map
      $readOptions "stdout_offset" $worker "stdout_offset" at put drop
      $readOptions "stderr_offset" $worker "stderr_offset" at put drop
      $worker "job_id" at $readOptions process_read readResult var
      $readResult ok? false = if
        $readResult finalResult set
        break
      end
      $readResult value read var
      $worker $read py_worker_commit_read drop
      $read "stdout" at stdoutText var
      $worker "stdout_buffer" at $stdoutText concat combinedText var
      "" nextBuffer var
      $combinedText "\n" ends_with? $combinedText "\r" ends_with? or ended var
      $combinedText lines stdoutLines var
      0 lineIndex var
      $stdoutLines count totalLines var
      $lineIndex $stdoutLines count < while
        $stdoutLines $lineIndex at rawLine var
        $lineIndex $totalLines 1 - = isLastLine var
        $ended false = $isLastLine and if
          $rawLine nextBuffer set
        else
          $rawLine trim responseLine var
          $responseLine blank? false = if
            $responseLine $request "id" at py_worker_decode_line finalResult set
            break
          end
        end
        $lineIndex 1 + lineIndex set
      end
      $worker "stdout_buffer" $nextBuffer put drop
      $finalResult nil? false = if
        break
      end
      $read "running" at false = if
        "PythonWorkerClosed" "Python worker exited before answering the request" fail finalResult set
        break
      end
      25 sleep
      $attempts 1 + attempts set
    end
  end
  $finalResult nil? if
    "PythonWorkerTimeout" "Python worker did not answer within the polling budget" fail finalResult set
  end
  $finalResult
end

( worker op payload -> Result ) py_worker_request function
  payload var
  op var
  worker var
  $worker py_worker_next_id id var
  $id $op $payload py_request request var
  $worker $request py_worker_exchange
end

( worker -> Result ) py_worker_shutdown function
  worker var
  payload map
  $worker "shutdown" $payload py_worker_request
end
