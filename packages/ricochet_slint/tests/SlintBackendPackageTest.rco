"../backend" import

SlintBackendPackageTest TestCase Subclass
  [
    slint_backend backend var
    $backend "id" at "slint" assert_equals
    $backend "platform" at "cross_platform" assert_equals
    $backend "native" at true assert_equals
  ] "testBackendDescriptor" Method
  [
    options map
    $options "style" "fluent" put drop
    $options slint_required_options wrapped var
    $wrapped "backend" at "slint" assert_equals
    $wrapped "required" at true assert_equals
    $wrapped "options" at "style" at "fluent" assert_equals
  ] "testRequiredOptions" Method
end
