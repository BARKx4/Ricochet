(( Form maps and validation result helpers. ))
( name value -> Map ) form_field function
  value var
  name var
  field map
  $field "name" $name put drop
  $field "value" $value put drop
  $field
end

( value -> Bool ) form_required function
  value var
  $value nil? if
    false
  else
    $value blank? false =
  end
end

( field message -> Map ) form_error function
  message var
  field var
  error map
  $error "field" $field put drop
  $error "message" $message put drop
  $error
end

( -> Map ) form_validation function
  validation map
  errors array
  $validation "ok" true put drop
  $validation "errors" $errors put drop
  $validation
end

( validation error -> Map ) form_add_error function
  error var
  validation var
  $validation "errors" at $error push drop
  $validation "ok" false put drop
  $validation
end

( -> Map ) form_schema function
  schema map
  $schema
end

( type required -> Map ) form_schema_rule function
  required var
  type var
  rule map
  $rule "type" $type put drop
  $rule "required" $required put drop
  $rule
end

( schema name type -> Map ) form_required_field function
  type var
  name var
  schema var
  $type true form_schema_rule rule var
  $schema $name $rule put drop
  $schema
end

( schema name type -> Map ) form_optional_field function
  type var
  name var
  schema var
  $type false form_schema_rule rule var
  $schema $name $rule put drop
  $schema
end

( value expectedType -> Bool ) form_type_matches function
  expectedType var
  value var
  $expectedType "any" = if
    true
  else
    $value type $expectedType =
  end
end

( data schema -> Map ) form_schema_validate function
  schema var
  data var
  form_validation validation var

  [
    rule var
    field var
    $rule "type" at typeName var
    $data $field at value var

    $rule "required" at true = if
      $value nil? if
        $validation $field "is required" form_error form_add_error validation set
      else
        $typeName "string" = if
          $value blank? if
            $validation $field "is required" form_error form_add_error validation set
          end
        end
      end
    end

    $value nil? false = if
      $value $typeName form_type_matches false = if
        $validation $field "must be " $typeName concat form_error form_add_error validation set
      end
    end
  ] $schema each drop

  $validation
end

( name filename contentType size -> Map ) form_multipart_file function
  size var
  contentType var
  filename var
  name var
  file map
  $file "name" $name put drop
  $file "filename" $filename put drop
  $file "content_type" $contentType put drop
  $file "size" $size put drop
  $file
end
