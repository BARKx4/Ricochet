"../validation" import

"email" "ada@example.com" form_field field var

$field "value" at form_required println

form_validation validation var

$validation "email" "Email is required" form_error form_add_error json-encode println

form_schema
  "email" "string" form_required_field
  "age" "number" form_optional_field
schema var

data map
$data "email" "ada@example.com" put! drop
$data "age" 37 put! drop

$data $schema form_schema_validate json-encode println
