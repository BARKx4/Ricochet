"../validation" import

FormsPackageTest TestCase Subclass
  [
    "name" "Ada" form_field "value" at
    "Ada" assert-equals
  ] "testFieldValue" Method
  [
    "  " form_required
    false assert-equals
  ] "testBlankRequired" Method
  [
    form_validation "email" "Email required" form_error form_add_error "ok" at
    false assert-equals
  ] "testValidationError" Method
  [
    form_schema "email" "string" form_required_field "age" "number" form_optional_field schema var
    data map
    $data "email" "ada@example.com" put! drop
    $data "age" 37 put! drop
    $data $schema form_schema_validate "ok" at
    true assert-equals
  ] "testSchemaValidationAcceptsValidData" Method
  [
    form_schema "email" "string" form_required_field schema var
    data map
    $data $schema form_schema_validate result var
    $result "ok" at false assert-equals
    $result "errors" at first "field" at "email" assert-equals
  ] "testSchemaValidationRequiresFields" Method
  [
    form_schema "age" "number" form_required_field schema var
    data map
    $data "age" "old" put! drop
    $data $schema form_schema_validate result var
    $result "ok" at false assert-equals
    $result "errors" at first "message" at "must be number" assert-equals
  ] "testSchemaValidationReportsTypeMismatch" Method
  [
    form_schema "nickname" "string" form_optional_field schema var
    data map
    $data $schema form_schema_validate "ok" at
    true assert-equals
  ] "testSchemaValidationAllowsMissingOptionalFields" Method
end
