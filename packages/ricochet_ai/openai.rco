(( Provider-neutral AI request helpers with an OpenAI-compatible starter shape. ))
( name value headers -> Map ) ai_header_put function
  headers var
  value var
  name var
  $headers $name $value put! drop
  $headers
end

( token -> Map ) ai_bearer_headers function
  token var
  headers map
  "Authorization" "Bearer " $token concat $headers ai_header_put drop
  "Content-Type" "application/json" $headers ai_header_put
end

( envName -> Map ) ai_secret_ref function
  envName var
  $envName secret_env
end

( provider baseUrl model -> Map ) ai_provider function
  model var
  baseUrl var
  providerName var
  provider map
  $provider "provider" $providerName put! drop
  $provider "base_url" $baseUrl put! drop
  $provider "model" $model put! drop
  $provider
end

( role content -> Map ) ai_message function
  content var
  role var
  message map
  $message "role" $role put! drop
  $message "content" $content put! drop
  $message
end

( content -> Map ) ai_system_message function
  content var
  "system" $content ai_message
end

( content -> Map ) ai_user_message function
  content var
  "user" $content ai_message
end

( content -> Map ) ai_assistant_message function
  content var
  "assistant" $content ai_message
end

( provider model messages options tools retry -> Map ) ai_chat_request function
  retry var
  tools var
  options var
  messages var
  model var
  provider var
  request map
  $request "provider" $provider put! drop
  $request "model" $model put! drop
  $request "messages" $messages put! drop
  $request "stream" false put! drop
  $request "options" $options put! drop
  $request "tools" $tools put! drop
  $request "retry" $retry put! drop
  $request
end

( provider model messages options tools retry -> Map ) ai_chat_stream function
  retry var
  tools var
  options var
  messages var
  model var
  provider var
  $provider $model $messages $options $tools $retry ai_chat_request request var
  $request "stream" true put! drop
  $request
end

( maxAttempts initialDelayMs maxDelayMs -> Map ) ai_retry_policy function
  maxDelayMs var
  initialDelayMs var
  maxAttempts var
  retry map
  $retry "max_attempts" $maxAttempts put! drop
  $retry "initial_delay_ms" $initialDelayMs put! drop
  $retry "max_delay_ms" $maxDelayMs put! drop
  $retry
end

( kind -> Bool ) ai_retryable_kind function
  kind var
  $kind nil? if
    false
  else
    $kind lowercase normalizedKind var
    $normalizedKind "rate_limit" =
    $normalizedKind "timeout" = or
    $normalizedKind "server_error" = or
    $normalizedKind "network" = or
    $normalizedKind "transient" = or
  end
end

( kind -> Bool ) ai_nonretryable_kind function
  kind var
  $kind nil? if
    false
  else
    $kind lowercase normalizedKind var
    $normalizedKind "validation" =
    $normalizedKind "validation_error" = or
    $normalizedKind "auth" = or
    $normalizedKind "auth_error" = or
    $normalizedKind "authentication" = or
    $normalizedKind "authentication_error" = or
    $normalizedKind "unauthorized" = or
    $normalizedKind "user" = or
    $normalizedKind "user_error" = or
  end
end

( status -> Bool ) ai_retryable_status function
  status var
  $status nil? if
    false
  else
    $status 408 =
    $status 409 = or
    $status 425 = or
    $status 429 = or
    $status 500 >= $status 599 <= and or
  end
end

( status -> Bool ) ai_nonretryable_status function
  status var
  $status nil? if
    false
  else
    $status 400 >= $status 499 <= and
  end
end

( errorMap -> Bool ) ai_retryable_error? function
  errorMap var
  $errorMap "kind" at kind var
  $errorMap "status" at status var
  $kind ai_nonretryable_kind if
    false
  else
    $status ai_retryable_status if
      true
    else
      $status ai_nonretryable_status if
        false
      else
        $kind ai_retryable_kind
      end
    end
  end
end

( attempt retryPolicy -> Number ) ai_retry_delay_ms function
  retryPolicy var
  attempt var
  $attempt 0 > not if
    1 attempt set
  end

  0 initialDelayMs var
  0 maxDelayMs var

  $retryPolicy nil? false = if
    $retryPolicy "initial_delay_ms" at initialDelayValue var
    $retryPolicy "max_delay_ms" at maxDelayValue var
    $initialDelayValue nil? false = if
      $initialDelayValue initialDelayMs set
    end
    $maxDelayValue nil? false = if
      $maxDelayValue maxDelayMs set
    end
  end

  $initialDelayMs 0 > not if
    0 initialDelayMs set
  end
  $maxDelayMs 0 > not if
    0 maxDelayMs set
  end

  $initialDelayMs 0 = if
    0
  else
    $initialDelayMs delayMs var
    $attempt 1 - remaining var
    $remaining 0 > while
      $delayMs 2 * delayMs set
      $remaining 1 - remaining set
    end
    $delayMs $maxDelayMs min
  end
end

( request executorBlock -> Result ) ai_execute_with_retry function
  executorBlock var
  request var
  $request "retry" at retryPolicy var
  1 maxAttempts var
  $retryPolicy nil? false = if
    $retryPolicy "max_attempts" at maxAttemptsValue var
    $maxAttemptsValue nil? false = if
      $maxAttemptsValue maxAttempts set
    end
  end
  $maxAttempts 0 > not if
    1 maxAttempts set
  end

  1 attempt var
  nil finalResult var

  $attempt $maxAttempts > not while
    $request $attempt $executorBlock call drop result var
    $result ok? if
      $result finalResult set
      break
    end

    $result error errorMap var
    $errorMap ai_retryable_error? retryable var
    $attempt $maxAttempts < attemptsRemain var

    $retryable $attemptsRemain and if
      $attempt $retryPolicy ai_retry_delay_ms delayMs var
      $delayMs 0 > if
        $delayMs sleep
      end
      $attempt 1 + attempt set
      continue
    end

    $result finalResult set
    break
  end

  $finalResult
end

( provider model text toolCalls raw -> Map ) ai_chat_response function
  raw var
  toolCalls var
  text var
  model var
  provider var
  response map
  $response "provider" $provider put! drop
  $response "model" $model put! drop
  $response "text" $text put! drop
  $response "tool_calls" $toolCalls put! drop
  $response "raw" $raw put! drop
  $response
end

( provider kind message status raw -> Map ) ai_error function
  raw var
  status var
  message var
  kind var
  provider var
  error map
  $error "provider" $provider put! drop
  $error "kind" $kind put! drop
  $error "message" $message put! drop
  $error "status" $status put! drop
  $error "raw" $raw put! drop
  $error
end

( kind data offset done -> Map ) ai_stream_event function
  done var
  offset var
  data var
  kind var
  event map
  $event "kind" $kind put! drop
  $event "data" $data put! drop
  $event "offset" $offset put! drop
  $event "done" $done put! drop
  $event
end

( id name arguments -> Map ) ai_tool_call function
  arguments var
  name var
  id var
  toolCall map
  $toolCall "id" $id put! drop
  $toolCall "name" $name put! drop
  $toolCall "arguments" $arguments put! drop
  $toolCall
end

( toolCallId content -> Map ) ai_tool_result function
  content var
  toolCallId var
  result map
  $result "role" "tool" put! drop
  $result "tool_call_id" $toolCallId put! drop
  $result "content" $content put! drop
  $result
end

( -> Map ) ai_tool_handlers function
  handlers map
  $handlers
end

( handlers name block -> Map ) ai_tool_handler_put function
  block var
  name var
  handlers var
  $handlers $name $block put! drop
  $handlers
end

( toolCall handlers -> Result ) ai_execute_tool_call function
  handlers var
  toolCall var
  $toolCall "name" at name var
  $handlers $name at handler var
  $handler nil? if
    "AiToolNotFound" "No AI tool handler registered for " $name concat fail
  else
    $toolCall $toolCall "arguments" at $handler call drop content var
    $toolCall "id" at $content ai_tool_result ok
  end
end

( toolCalls handlers -> Result ) ai_execute_tool_calls function
  handlers var
  toolCalls var
  results array
  nil finalResult var
  0 index var
  $toolCalls count total var

  $index $total < while
    $toolCalls $index at toolCall var
    $toolCall $handlers ai_execute_tool_call result var
    $result ok? if
      $results $result value push! drop
      $index 1 + index set
    else
      $result finalResult set
      break
    end
  end

  $finalResult nil? if
    $results ok
  else
    $finalResult
  end
end

( -> Map ) ai_schema function
  schema map
  $schema
end

( type required -> Map ) ai_schema_rule function
  required var
  typeName var
  rule map
  $rule "type" $typeName put! drop
  $rule "required" $required put! drop
  $rule
end

( schema field type required -> Map ) ai_schema_field function
  required var
  typeName var
  field var
  schema var
  $typeName $required ai_schema_rule rule var
  $schema $field $rule put! drop
  $schema
end

( field message -> Map ) ai_validation_error function
  message var
  field var
  error map
  $error "field" $field put! drop
  $error "message" $message put! drop
  $error
end

( -> Map ) ai_validation_result function
  validation map
  errors array
  $validation "ok" true put! drop
  $validation "errors" $errors put! drop
  $validation
end

( validation error -> Map ) ai_validation_add_error function
  error var
  validation var
  $validation "errors" at $error push! drop
  $validation "ok" false put! drop
  $validation
end

( value expectedType -> Bool ) ai_type_matches function
  expectedType var
  value var
  $expectedType "any" = if
    true
  else
    $value type $expectedType =
  end
end

( data schema -> Map ) ai_validate_schema function
  schema var
  data var
  ai_validation_result validation var

  [
    rule var
    field var
    $rule "type" at typeName var
    $data $field at value var

    $rule "required" at true = if
      $value nil? if
        $validation $field "is required" ai_validation_error ai_validation_add_error validation set
      end
    end

    $value nil? false = if
      $value $typeName ai_type_matches false = if
        $validation $field "must be " $typeName concat ai_validation_error ai_validation_add_error validation set
      end
    end
  ] $schema each drop

  $validation
end

( model messages -> Map ) ai_openai_chat_body function
  messages var
  model var
  body map
  $body "model" $model put! drop
  $body "messages" $messages put! drop
  $body
end

( model messages -> Map ) ai_openai_chat_stream_body function
  messages var
  model var
  $model $messages ai_openai_chat_body body var
  $body "stream" true put! drop
  $body
end

( baseUrl token model messages -> Map ) ai_openai_chat_request function
  messages var
  model var
  token var
  baseUrl var
  $model $messages ai_openai_chat_body body var
  "POST" $baseUrl "/chat/completions" concat http_request_new value request var
  $request $token http_bearer_auth value request set
  $request "Content-Type" "application/json" http_header_put value request set
  $request $body http_json_body value request set
  $request
end

( baseUrl token model messages -> Map ) ai_openai_chat_stream_request function
  messages var
  model var
  token var
  baseUrl var
  $model $messages ai_openai_chat_stream_body body var
  "POST" $baseUrl "/chat/completions" concat http_request_new value request var
  $request $token http_bearer_auth value request set
  $request "Content-Type" "application/json" http_header_put value request set
  $request "Accept" "text/event-stream" http_header_put value request set
  $request $body http_json_body value request set
  $request
end

( line -> String ) ai_sse_data_line function
  line var
  $line trim line set
  $line "data:" starts_with? if
    $line 5 $line length slice trim
  else
    nil
  end
end

( body -> Array ) ai_sse_data_lines function
  body var
  values array
  [
    ai_sse_data_line value var
    $value nil? false = if
      $values $value push! drop
    end
  ] $body lines each drop
  $values
end

( body -> Array ) ai_sse_json_events function
  body var
  events array
  [
    data var
    $data "[DONE]" = false = if
      $data json_decode value $events swap push! drop
    end
  ] $body ai_sse_data_lines each drop
  $events
end

( event -> String ) ai_openai_stream_delta function
  event var
  $event "choices" at choices var
  $choices nil? if
    nil
  else
    $choices first choice var
    $choice nil? if
      nil
    else
      $choice "delta" at delta var
      $delta nil? if
        nil
      else
        $delta "content" at
      end
    end
  end
end

( body -> String ) ai_openai_stream_text function
  body var
  "" text var
  [
    ai_openai_stream_delta part var
    $part nil? false = if
      $text $part concat text set
    end
  ] $body ai_sse_json_events each drop
  $text
end

( response -> Map ) ai_response_summary function
  response var
  summary map
  $summary "status" $response "status" at put! drop
  $summary "ok" $response "status" at 200 = put! drop
  $summary "body" $response "body" at put! drop
  $summary
end
