  ] "testOllamaProviderAndRequestMaps" Method
  [
    "http://127.0.0.1:11434" "llama3.2" ai_ollama_provider provider var
    messages array
    $messages "hello" ai_user_message push! drop
    options map
    tools array
    2 0 0 ai_retry_policy retry var
    $provider "llama3.2" $messages $options $tools $retry ai_chat_request request var
    attempts array

    [
      attempt var
      providerRequest var
      $attempts $attempt push! drop
      response map
      $attempt 1 = if
        $response "status" 503 put! drop
        $response "body" "{\"error\":\"busy\"}" put! drop
      else
        $response "status" 200 put! drop
        $response "body" "{\"model\":\"llama3.2\",\"message\":{\"role\":\"assistant\",\"content\":\"local model ready\"},\"done\":true}" put! drop
      end
      $response ok
    ] executor var

    $request $executor ai_ollama_execute_chat result var
    $result ok? true assert_equals
    $result value "text" at "local model ready" assert_equals
    $result value "model" at "llama3.2" assert_equals
    $attempts count 2 assert_equals
  ] "testOllamaExecuteChatRetriesFakeProviderStatus" Method
  [
    "{\"model\":\"llama3.2\",\"message\":{\"content\":\"Hel\"},\"done\":false}\n{\"model\":\"llama3.2\",\"message\":{\"content\":\"lo\"},\"done\":false}\n{\"model\":\"llama3.2\",\"done\":true}\n" body var
    $body ai_ollama_stream_events result var
    $result ok? true assert_equals
    $result value events var
    $events count 3 assert_equals
    $events first "kind" at "delta" assert_equals
    $events first "data" at "Hel" assert_equals
    $events 1 at "data" at "lo" assert_equals
    $events 2 at "kind" at "done" assert_equals
    $events 2 at "done" at true assert_equals
  ] "testOllamaStreamEventsReturnChunksAndDone" Method
  [
    "{bad-json}\n" ai_ollama_stream_events result var
    $result ok? false assert_equals
    $result error "kind" at "AiProviderMalformedEvent" assert_equals
  ] "testOllamaStreamEventsReportMalformedEvents" Method
  [
    ai_ollama_stream_state state var
    read1 map
    $read1 "body" "{\"model\":\"llama3.2\",\"message\":{\"content\":\"Hel\"" put! drop
    $read1 "next_offset" 12 put! drop
    $read1 "done" false put! drop
    $state $read1 ai_ollama_stream_read_events firstResult var
    $firstResult ok? true assert_equals
    $firstResult value "events" at count 0 assert_equals
    $firstResult value "state" at state set

    read2 map
    $read2 "body" "},\"done\":false}\n{\"model\":\"llama3.2\",\"done\":true}" put! drop
    $read2 "next_offset" 64 put! drop
    $read2 "done" true put! drop
    $state $read2 ai_ollama_stream_read_events secondResult var
    $secondResult ok? true assert_equals
    $secondResult value "events" at events var
    $events count 2 assert_equals
    $events first "kind" at "delta" assert_equals
    $events first "data" at "Hel" assert_equals
    $events first "offset" at 0 assert_equals
    $events 1 at "kind" at "done" assert_equals
    $events 1 at "offset" at 1 assert_equals
    $secondResult value "done" at true assert_equals
    $secondResult value "state" at "buffer" at "" assert_equals
