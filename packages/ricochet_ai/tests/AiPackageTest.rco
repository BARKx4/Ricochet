    $request "headers" at "Accept" at
    "text/event-stream" assert_equals
    $request "json" at "stream" at
    true assert_equals
  ] "testOpenAiStreamRequest" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_sse_data_lines count
    3 assert_equals
  ] "testSseDataLines" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_sse_json_events count
    2 assert_equals
  ] "testSseJsonEventsSkipDone" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_openai_stream_text
    "Hello" assert_equals
  ] "testOpenAiStreamText" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    $messages "hello" ai_user_message push! drop
    options map
    tools array
    3 0 0 ai_retry_policy retry var
    $provider "gpt-test" $messages $options $tools $retry ai_chat_request request var
    attempts array

    [
      attempt var
      providerRequest var
      $attempts $attempt push! drop
      response map
      $attempt 1 = if
        $response "status" 503 put! drop
        $response "body" "{\"error\":{\"message\":\"busy\"}}" put! drop
      else
        $response "status" 200 put! drop
        $response "body" "{\"model\":\"gpt-test\",\"choices\":[{\"message\":{\"content\":\"hello from fake\"}}]}" put! drop
      end
      $response ok
    ] executor var

    $request $executor ai_openai_execute_chat result var
    $result ok? true assert_equals
    $result value "text" at "hello from fake" assert_equals
    $attempts count 2 assert_equals
  ] "testOpenAiExecuteChatRetriesFakeProviderStatus" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    options map
    tools array
    1 0 0 ai_retry_policy retry var
    $provider "gpt-test" $messages $options $tools $retry ai_chat_request request var

    [
      drop
      drop
      response map
      $response "status" 200 put! drop
      $response "body" "{\"model\":\"gpt-test\",\"choices\":[{\"message\":{\"tool_calls\":[{\"id\":\"call-1\",\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"arguments\":\"{\\\"city\\\":\\\"Chicago\\\"}\"}}]}}]}" put! drop
      $response ok
    ] executor var

    $request $executor ai_openai_execute_chat result var
    $result ok? true assert_equals
    $result value "tool_calls" at toolCalls var
    $toolCalls count 1 assert_equals
    $toolCalls first "id" at "call-1" assert_equals
    $toolCalls first "name" at "get_weather" assert_equals
    $toolCalls first "arguments" at "city" at "Chicago" assert_equals
  ] "testOpenAiExecuteChatExtractsFakeProviderToolCalls" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_openai_stream_events result var
    $result ok? true assert_equals
    $result value events var
    $events count 3 assert_equals
    $events first "kind" at "delta" assert_equals
    $events first "data" at "Hel" assert_equals
    $events 1 at "data" at "lo" assert_equals
    $events 2 at "kind" at "done" assert_equals
    $events 2 at "done" at true assert_equals
  ] "testOpenAiStreamEventsReturnChunksAndDone" Method
  [
    "data: {bad-json}\n\n" ai_openai_stream_events result var
    $result ok? false assert_equals
    $result error "kind" at "AiProviderMalformedEvent" assert_equals
  ] "testOpenAiStreamEventsReportMalformedEvents" Method
  [
    ai_openai_stream_state state var
    $state "offset" 17 put! drop
    $state 4096 ai_stream_read_options options var
    $options "offset" at 17 assert_equals
    $options "max_bytes" at 4096 assert_equals
    $state nil ai_stream_read_options nilOptions var
    $nilOptions "offset" at 17 assert_equals
    $nilOptions "max_bytes" at nil? true assert_equals
  ] "testAiStreamReadOptionsUseStateOffset" Method
  [
    ai_openai_stream_state state var

    read1 map
    $read1 "body" "data: {\"choices\":[{\"delta\":{\"content\":\"Hel" put! drop
    $read1 "next_offset" 10 put! drop
    $read1 "done" false put! drop
    $state $read1 ai_openai_stream_read_events firstResult var
    $firstResult ok? true assert_equals
    $firstResult value "events" at count 0 assert_equals
    $firstResult value "offset" at 10 assert_equals
    $firstResult value "state" at state set
    $state "buffer" at length 0 > true assert_equals

    read2 map
    $read2 "body" "lo\"}}]}\n\n" put! drop
    $read2 "next_offset" 20 put! drop
    $read2 "done" false put! drop
    $state $read2 ai_openai_stream_read_events secondResult var
    $secondResult ok? true assert_equals
    $secondResult value "events" at events var
    $events count 1 assert_equals
    $events first "kind" at "delta" assert_equals
    $events first "data" at "Hello" assert_equals
    $events first "offset" at 0 assert_equals
    $secondResult value "state" at state set
    $state "buffer" at "" assert_equals

    read3 map
    $read3 "body" "data: [DONE]\n\n" put! drop
    $read3 "next_offset" 35 put! drop
    $read3 "done" true put! drop
    $state $read3 ai_openai_stream_read_events thirdResult var
    $thirdResult ok? true assert_equals
    $thirdResult value "events" at doneEvents var
    $doneEvents count 1 assert_equals
    $doneEvents first "kind" at "done" assert_equals
    $doneEvents first "offset" at 1 assert_equals
    $thirdResult value "done" at true assert_equals
    $thirdResult value "protocol_done" at true assert_equals
    $thirdResult value "offset" at 35 assert_equals
    $thirdResult value "state" at "event_offset" at 2 assert_equals
  ] "testOpenAiStreamReadEventsConsumeSplitFramesAndDone" Method
  [
    ai_openai_stream_state state var
    read1 map
    $read1 "body" "data: {bad" put! drop
    $read1 "next_offset" 10 put! drop
    $read1 "done" false put! drop
    $state $read1 ai_openai_stream_read_events firstResult var
    $firstResult ok? true assert_equals
    $firstResult value "events" at count 0 assert_equals
    $firstResult value "state" at state set

    read2 map
    $read2 "body" "-json}\n\n" put! drop
    $read2 "next_offset" 20 put! drop
    $read2 "done" false put! drop
    $state $read2 ai_openai_stream_read_events secondResult var
    $secondResult ok? false assert_equals
    $secondResult error "kind" at "AiProviderMalformedEvent" assert_equals
  ] "testOpenAiStreamReadEventsDeferMalformedPartialFrames" Method
