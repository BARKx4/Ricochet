"../openai" import

AiPackageTest TestCase Subclass
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    $provider "provider" at
    "openai" assert_equals
    $provider "base_url" at
    "https://api.example.test/v1" assert_equals
    $provider "model" at
    "gpt-test" assert_equals
  ] "testProviderMap" Method
  [
    "system rules" ai_system_message systemMessage var
    $systemMessage "role" at "system" assert_equals
    $systemMessage "content" at "system rules" assert_equals
    "user text" ai_user_message "role" at "user" assert_equals
    "assistant text" ai_assistant_message "content" at "assistant text" assert_equals
    "custom" "payload" ai_message "role" at "custom" assert_equals
  ] "testMessageHelpers" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    $messages "hello" ai_user_message push! drop
    options map
    $options "temperature" 0.2 put! drop
    tools array
    3 100 1000 ai_retry_policy retry var

    $provider "gpt-test" $messages $options $tools $retry ai_chat_request request var
    $request "provider" at "provider" at "openai" assert_equals
    $request "model" at "gpt-test" assert_equals
    $request "messages" at count 1 assert_equals
    $request "stream" at false assert_equals
    $request "options" at "temperature" at 0.2 assert_equals
    $request "tools" at count 0 assert_equals
    $request "retry" at "max_attempts" at 3 assert_equals
    $request "retry" at "initial_delay_ms" at 100 assert_equals
    $request "retry" at "max_delay_ms" at 1000 assert_equals
  ] "testChatRequestMap" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    options map
    tools array
    2 50 500 ai_retry_policy retry var
    $provider "gpt-test" $messages $options $tools $retry ai_chat_stream request var
    $request "stream" at true assert_equals
    $request "retry" at "max_attempts" at 2 assert_equals
  ] "testChatStreamMap" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    toolCalls array
    raw map
    $raw "id" "chatcmpl-test" put! drop
    $provider "gpt-test" "hello" $toolCalls $raw ai_chat_response response var
    $response "provider" at "provider" at "openai" assert_equals
    $response "model" at "gpt-test" assert_equals
    $response "text" at "hello" assert_equals
    $response "tool_calls" at count 0 assert_equals
    $response "raw" at "id" at "chatcmpl-test" assert_equals

    $provider "rate_limit" "slow down" 429 $raw ai_error providerError var
    $providerError "kind" at "rate_limit" assert_equals
    $providerError "message" at "slow down" assert_equals
    $providerError "status" at 429 assert_equals

    "delta" $raw 12 false ai_stream_event event var
    $event "kind" at "delta" assert_equals
    $event "offset" at 12 assert_equals
    $event "done" at false assert_equals
  ] "testNormalizedResponseErrorAndStreamEventMaps" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    raw map
    $provider "server_error" "try again" 500 $raw ai_error ai_retryable_error?
    true assert_equals
    $provider "unknown" "gateway down" 503 $raw ai_error ai_retryable_error?
    true assert_equals
    $provider "validation" "bad request" 400 $raw ai_error ai_retryable_error?
    false assert_equals
    $provider "unknown" "bad request" 400 $raw ai_error ai_retryable_error?
    false assert_equals
  ] "testRetryableErrorStatusHandling" Method
  [
    4 100 250 ai_retry_policy retry var
    0 $retry ai_retry_delay_ms
    100 assert_equals
    2 $retry ai_retry_delay_ms
    200 assert_equals
    4 $retry ai_retry_delay_ms
    250 assert_equals
  ] "testRetryDelayCap" Method
  [
    409 ai_openai_error_kind "transient" assert_equals
    425 ai_openai_error_kind "transient" assert_equals
    401 ai_openai_error_kind "auth" assert_equals
    500 ai_openai_error_kind "server_error" assert_equals
  ] "testOpenAiErrorKindPreservesRetryableStatuses" Method
  [
    request map
    3 0 0 ai_retry_policy retry var
    $request "retry" $retry put! drop
    attempts array

    [
      attempt var
      request var
      $attempts $attempt push! drop
      $attempt 3 < if
        "rate_limit" "retry later" fail result var
        $result error "status" 429 put! drop
        $result
      else
        response map
        $response "attempt" $attempt put! drop
        $response ok
      end
    ] executor var

    $request $executor ai_execute_with_retry result var
    $result ok? true assert_equals
    $result value "attempt" at 3 assert_equals
    $attempts count 3 assert_equals
  ] "testExecuteWithRetryRetriesRetryableErrors" Method
  [
    request map
    5 0 0 ai_retry_policy retry var
    $request "retry" $retry put! drop
    attempts array

    [
      attempt var
      request var
      $attempts $attempt push! drop
      "validation" "bad input" fail
    ] executor var

    $request $executor ai_execute_with_retry result var
    $result ok? false assert_equals
    $result error "kind" at "validation" assert_equals
    $attempts count 1 assert_equals
  ] "testExecuteWithRetrySkipsNonretryableErrors" Method
  [
    request map
    [ drop drop "plain-ok" ok ] executor var
    $request $executor ai_execute_with_retry result var
    $result ok? true assert_equals
    $result value "plain-ok" assert_equals
  ] "testExecuteWithRetrySupportsNoLocalExecutorBlocks" Method
  [
    args map
    $args "city" "Chicago" put! drop
    "call-1" "get_weather" $args ai_tool_call toolCall var
    $toolCall "id" at "call-1" assert_equals
    $toolCall "name" at "get_weather" assert_equals
    $toolCall "arguments" at "city" at "Chicago" assert_equals

    "call-1" "{\"ok\":true}" ai_tool_result toolResult var
    $toolResult "role" at "tool" assert_equals
    $toolResult "tool_call_id" at "call-1" assert_equals
    $toolResult "content" at "{\"ok\":true}" assert_equals
  ] "testToolCallAndToolResultMaps" Method
  [
    ai_tool_handlers handlers var
    $handlers "get_weather" [
      arguments var
      toolCall var
      content map
      $content "name" $toolCall "name" at put! drop
      $content "city" $arguments "city" at put! drop
      $content
    ] ai_tool_handler_put handlers set

    args map
    $args "city" "Chicago" put! drop
    "call-1" "get_weather" $args ai_tool_call toolCall var

    $toolCall $handlers ai_execute_tool_call result var
    $result ok? true assert_equals
    $result value "role" at "tool" assert_equals
    $result value "tool_call_id" at "call-1" assert_equals
    $result value "content" at "name" at "get_weather" assert_equals
    $result value "content" at "city" at "Chicago" assert_equals
  ] "testExecuteToolCallWrapsHandlerContent" Method
  [
    ai_tool_handlers handlers var
    $handlers "echo" [ drop drop "plain-content" ] ai_tool_handler_put handlers set
    args map
    "call-plain" "echo" $args ai_tool_call toolCall var
    $toolCall $handlers ai_execute_tool_call result var
    $result ok? true assert_equals
    $result value "content" at "plain-content" assert_equals
  ] "testExecuteToolCallSupportsNoLocalHandlerBlocks" Method
  [
    ai_tool_handlers handlers var
    args map
    "call-404" "missing_tool" $args ai_tool_call toolCall var
    $toolCall $handlers ai_execute_tool_call result var
    $result ok? false assert_equals
    $result error "kind" at "AiToolNotFound" assert_equals
  ] "testExecuteToolCallReportsMissingHandler" Method
  [
    ai_tool_handlers handlers var
    $handlers "echo" [
      arguments var
      toolCall var
      content map
      $content "tool" $toolCall "name" at put! drop
      $content "value" $arguments "value" at put! drop
      $content
    ] ai_tool_handler_put handlers set

    toolCalls array
    argsOne map
    $argsOne "value" "first" put! drop
    argsTwo map
    $argsTwo "value" "second" put! drop
    $toolCalls "call-1" "echo" $argsOne ai_tool_call push! drop
    $toolCalls "call-2" "echo" $argsTwo ai_tool_call push! drop

    $toolCalls $handlers ai_execute_tool_calls result var
    $result ok? true assert_equals
    $result value executed var
    $executed count 2 assert_equals
    $executed first "tool_call_id" at "call-1" assert_equals
    $executed first "content" at "value" at "first" assert_equals
    $executed 1 at "tool_call_id" at "call-2" assert_equals
    $executed 1 at "content" at "value" at "second" assert_equals
  ] "testExecuteToolCallsReturnsResultsInOrder" Method
  [
    ai_schema "text" "string" true ai_schema_field "score" "number" false ai_schema_field schema var
    data map
    $data "text" "hello" put! drop
    $data "score" 42 put! drop
    $data $schema ai_validate_schema "ok" at
    true assert_equals
  ] "testSchemaValidationAcceptsValidData" Method
  [
    ai_schema
      "enabled" "bool" true ai_schema_field
      "ratio" "float" true ai_schema_field
      "items" "array" true ai_schema_field
      "queue" "list" true ai_schema_field
      "meta" "map" true ai_schema_field
      "tags" "set" true ai_schema_field
      "anything" "any" true ai_schema_field schema var
    data map
    $data "enabled" true put! drop
    $data "ratio" 0.75 put! drop
    itemArray array
    $data "items" $itemArray put! drop
    itemList list
    $data "queue" $itemList put! drop
    meta map
    $data "meta" $meta put! drop
    tags Set
    $data "tags" $tags put! drop
    $data "anything" "freeform" put! drop
    $data $schema ai_validate_schema "ok" at
    true assert_equals
  ] "testSchemaValidationAcceptsSupportedTypes" Method
  [
    ai_schema "text" "string" true ai_schema_field schema var
    data map
    $data $schema ai_validate_schema result var
    $result "ok" at false assert_equals
    $result "errors" at first "field" at "text" assert_equals
    $result "errors" at first "message" at "is required" assert_equals
  ] "testSchemaValidationRequiresFields" Method
  [
    ai_schema "score" "number" true ai_schema_field schema var
    data map
    $data "score" "high" put! drop
    $data $schema ai_validate_schema result var
    $result "ok" at false assert_equals
    $result "errors" at first "field" at "score" assert_equals
    $result "errors" at first "message" at "must be number" assert_equals
  ] "testSchemaValidationReportsTypeMismatch" Method
  [
    ai_schema "nickname" "string" false ai_schema_field schema var
    data map
    $data $schema ai_validate_schema "ok" at
    true assert_equals
  ] "testSchemaValidationAllowsMissingOptionalFields" Method
  [
    "TOKEN" ai_bearer_headers "Authorization" at
    "Bearer TOKEN" assert_equals
  ] "testBearerHeaders" Method
  [
    messages array
    "gpt-test" $messages ai_openai_chat_body "model" at
    "gpt-test" assert_equals
  ] "testOpenAiBody" Method
  [
    messages array
    "gpt-test" $messages ai_openai_chat_stream_body "stream" at
    true assert_equals
  ] "testOpenAiStreamBody" Method
  [
    messages array
    "https://api.example.test/v1" "TOKEN" "gpt-test" $messages ai_openai_chat_stream_request request var
    $request "headers" at "Accept" at
    "text/event-stream" assert_equals
    $request "json" at "stream" at
    true assert_equals
  ] "testOpenAiStreamRequest" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_sse_data_lines count
    3 assert_equals
  ] "testSseDataLines" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_sse_json_events count
    2 assert_equals
  ] "testSseJsonEventsSkipDone" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_openai_stream_text
    "Hello" assert_equals
  ] "testOpenAiStreamText" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    $messages "hello" ai_user_message push! drop
    options map
    tools array
    3 0 0 ai_retry_policy retry var
    $provider "gpt-test" $messages $options $tools $retry ai_chat_request request var
    attempts array

    [
      attempt var
      providerRequest var
      $attempts $attempt push! drop
      response map
      $attempt 1 = if
        $response "status" 503 put! drop
        $response "body" "{\"error\":{\"message\":\"busy\"}}" put! drop
      else
        $response "status" 200 put! drop
        $response "body" "{\"model\":\"gpt-test\",\"choices\":[{\"message\":{\"content\":\"hello from fake\"}}]}" put! drop
      end
      $response ok
    ] executor var

    $request $executor ai_openai_execute_chat result var
    $result ok? true assert_equals
    $result value "text" at "hello from fake" assert_equals
    $attempts count 2 assert_equals
  ] "testOpenAiExecuteChatRetriesFakeProviderStatus" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    options map
    tools array
    1 0 0 ai_retry_policy retry var
    $provider "gpt-test" $messages $options $tools $retry ai_chat_request request var

    [
      drop
      drop
      response map
      $response "status" 200 put! drop
      $response "body" "{\"model\":\"gpt-test\",\"choices\":[{\"message\":{\"tool_calls\":[{\"id\":\"call-1\",\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"arguments\":\"{\\\"city\\\":\\\"Chicago\\\"}\"}}]}}]}" put! drop
      $response ok
    ] executor var

    $request $executor ai_openai_execute_chat result var
    $result ok? true assert_equals
    $result value "tool_calls" at toolCalls var
    $toolCalls count 1 assert_equals
    $toolCalls first "id" at "call-1" assert_equals
    $toolCalls first "name" at "get_weather" assert_equals
    $toolCalls first "arguments" at "city" at "Chicago" assert_equals
  ] "testOpenAiExecuteChatExtractsFakeProviderToolCalls" Method
  [
    "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: [DONE]\n\n" body var
    $body ai_openai_stream_events result var
    $result ok? true assert_equals
    $result value events var
    $events count 3 assert_equals
    $events first "kind" at "delta" assert_equals
    $events first "data" at "Hel" assert_equals
    $events 1 at "data" at "lo" assert_equals
    $events 2 at "kind" at "done" assert_equals
    $events 2 at "done" at true assert_equals
  ] "testOpenAiStreamEventsReturnChunksAndDone" Method
  [
    "data: {bad-json}\n\n" ai_openai_stream_events result var
    $result ok? false assert_equals
    $result error "kind" at "AiProviderMalformedEvent" assert_equals
  ] "testOpenAiStreamEventsReportMalformedEvents" Method
  [
    "openai" "https://api.example.test/v1" "gpt-test" ai_provider provider var
    messages array
    options map
    tools array
    1 0 0 ai_retry_policy retry var
    $provider "gpt-test" $messages $options $tools $retry ai_chat_request request var

    [
      drop
      drop
      response map
      $response "status" 200 put! drop
      $response "body" "{\"model\":\"gpt-test\",\"choices\":[{\"message\":{\"content\":\"high\"}}]}" put! drop
      $response ok
    ] executor var

    $request $executor ai_openai_execute_chat result var
    $result ok? true assert_equals
    ai_schema "text" "number" true ai_schema_field schema var
    $result value $schema ai_validate_schema validation var
    $validation "ok" at false assert_equals
    $validation "errors" at first "field" at "text" assert_equals
  ] "testFakeProviderResponseSchemaFailure" Method
end
