"../backend" import

AvaloniaBackendPackageTest TestCase Subclass
  [
    avalonia_backend backend var
    $backend "id" at "avalonia" assert_equals
    $backend "platform" at "cross-platform" assert_equals
    $backend "native" at true assert_equals
  ] "testBackendDescriptor" Method
  [
    options map
    $options "density" "compact" put drop
    $options avalonia_required_options wrapped var
    $wrapped "backend" at "avalonia" assert_equals
    $wrapped "required" at true assert_equals
    $wrapped "options" at "density" at "compact" assert_equals
  ] "testRequiredOptions" Method
end
