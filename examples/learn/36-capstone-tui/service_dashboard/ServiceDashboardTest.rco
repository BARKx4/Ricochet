"lib/status" import

ServiceDashboardTest TestCase Subclass
  [
    "[{\"status\":\"ok\",\"latency_ms\":10},{\"status\":\"degraded\",\"latency_ms\":40},{\"status\":\"ok\",\"latency_ms\":30},{\"status\":\"down\",\"latency_ms\":0}]" json_decode value services var

    $services "ok" service_count_status
    2 assert_equals

    $services "down" service_count_status
    1 assert_equals

    $services service_total_latency
    80 assert_equals

    $services service_average_latency
    20 assert_equals
  ] "testServiceCounters" Method

  [
    "[{\"status\":\"ok\",\"latency_ms\":10},{\"status\":\"degraded\",\"latency_ms\":40},{\"status\":\"ok\",\"latency_ms\":30},{\"status\":\"down\",\"latency_ms\":0}]" json_decode value services var
    $services service_summary summary var

    $summary "count" at
    4 assert_equals
    $summary "health_score" at
    50 assert_equals
    $summary "average_latency_ms" at
    20 assert_equals
  ] "testSummaryMap" Method
end
