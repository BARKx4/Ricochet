( line -> String ) ai_sse_data_line function
  line var
  $line trim line set
  $line "data:" starts_with? if
    $line 5 $line length slice trim
  else
    nil
  end
end

( body -> Array ) ai_sse_data_lines function
  body var
  values array
  [
    ai_sse_data_line value var
    $value nil? false = if
      $values $value push drop
    end
  ] $body lines each drop
  $values
end

( body -> Array ) ai_sse_json_events function
  body var
  events array
  [
    data var
    $data "[DONE]" = false = if
      $data json_decode value $events swap push drop
    end
  ] $body ai_sse_data_lines each drop
  $events
end

( provider format -> Map ) ai_stream_state_for function
  format var
  provider var
  state map
  $state "provider" $provider put drop
  $state "format" $format put drop
  $state "buffer" "" put drop
  $state "offset" 0 put drop
  $state "event_offset" 0 put drop
  $state "done" false put drop
  $state "protocol_done" false put drop
  $state "http_done" false put drop
  events array
  $state "events" $events put drop
  $state
end

( -> Map ) ai_openai_stream_state function
  "openai" "sse" ai_stream_state_for
end

( -> Map ) ai_anthropic_stream_state function
