end

( state maxBytes -> Map ) ai_stream_read_options function
  maxBytes var
  state var
  options map
  $options "offset" $state "offset" at put drop
  $maxBytes nil? false = if
    $options "max_bytes" $maxBytes put drop
  end
  $options
end

( read -> String ) ai_stream_read_body function
  read var
  $read "body" at body var
  $body nil? if
    ""
  else
    $body
  end
end

( state read -> Number ) ai_stream_read_next_offset function
  read var
  state var
  $read "next_offset" at nextOffset var
  $nextOffset nil? if
    $read "offset" at nextOffset set
  end
  $nextOffset nil? if
    $state "offset" at nextOffset set
  end
  $nextOffset nil? if
    0
  else
    $nextOffset
  end
end

( read -> Bool ) ai_stream_read_done function
  read var
  $read "done" at true =
end

( body buffer done -> Map ) ai_stream_flush_buffer_if_done function
  done var
  buffer var
  body var
  output map
  $done $buffer length 0 > and if
    $body length 0 > if
      $body "\n" concat $buffer concat body set
    else
      $buffer body set
    end
    "" buffer set
  end
  $output "body" $body put drop
  $output "buffer" $buffer put drop
  $output
end

( text -> Map ) ai_sse_complete_body function
  text var
  completeLines array
  currentLines array

  [
    line var
    $line trim length 0 = if
      $currentLines count 0 > if
        [
          frameLine var
          $completeLines $frameLine push drop
        ] $currentLines each drop
        $completeLines "" push drop
        nextLines array
        $nextLines currentLines set
      end
    else
      $currentLines $line push drop
    end
  ] $text lines each drop

  output map
  $output "body" $completeLines "\n" join put drop
  $output "buffer" $currentLines "\n" join put drop
  $output
end

( text -> Map ) ai_ndjson_complete_body function
  text var
  completeLines array
  "" pending var
  $text lines bodyLines var
  $text "\n" ends_with? $text "\r" ends_with? or ended var
  0 index var
  $bodyLines count total var
  $total 1 - lastIndex var

  $index $total < while
    $bodyLines $index at line var
    $index $lastIndex = isLast var
    $ended $isLast false = or if
      $completeLines $line push drop
    else
      $line pending set
    end
    $index 1 + index set
  end

  output map
  $output "body" $completeLines "\n" join put drop
  $output "buffer" $pending put drop
  $output
end

( state events -> Bool ) ai_stream_events_include_done function
  events var
  state var
  $state "protocol_done" at true = protocolDone var
  0 index var
  $events count total var

  $index $total < while
    $events $index at event var
    $event "done" at true = if
      true protocolDone set
      break
    end
    $index 1 + index set
  end

  $protocolDone
end

( state events -> Map ) ai_stream_rebase_events function
  events var
  state var
  $state "event_offset" at baseOffset var
  $baseOffset nil? if
    0 baseOffset set
  end
  0 index var
  $events count total var

  $index $total < while
    $events $index at event var
    $event "offset" $baseOffset $index + put drop
    $index 1 + index set
  end

  $state "event_offset" $baseOffset $total + put drop
  $state
end

( state events -> Map ) ai_stream_append_events function
  events var
  state var
  $state "events" at allEvents var
  $allEvents nil? if
    emptyEvents array
    $emptyEvents allEvents set
    $state "events" $allEvents put drop
  end

  [
    event var
    $allEvents $event push drop
  ] $events each drop

  $state
end

( state read events -> Map ) ai_stream_commit_read function
  events var
  read var
  state var
  $state $read ai_stream_read_next_offset nextOffset var
  $read ai_stream_read_done httpDone var
  $state $events ai_stream_events_include_done protocolDone var
  $protocolDone $httpDone or streamDone var

  $state "offset" $nextOffset put drop
  $state "http_done" $httpDone put drop
  $state "protocol_done" $protocolDone put drop
  $state "done" $streamDone put drop
  $state $events ai_stream_rebase_events drop
  $state $events ai_stream_append_events drop
  $state
end

( state events -> Map ) ai_stream_read_event_result function
  events var
  state var
  output map
  $output "state" $state put drop
  $output "events" $events put drop
  $output "offset" $state "offset" at put drop
  $output "done" $state "done" at put drop
  $output "protocol_done" $state "protocol_done" at put drop
  $output "http_done" $state "http_done" at put drop
  $output
end

( event -> String ) ai_openai_stream_delta function
  event var
  $event "choices" at choices var
  $choices nil? if
    nil
  else
    $choices first choice var
    $choice nil? if
      nil
    else
      $choice "delta" at delta var
      $delta nil? if
        nil
      else
        $delta "content" at
      end
    end
  end
end

( body -> String ) ai_openai_stream_text function
  body var
  "" text var
  [
    ai_openai_stream_delta part var
    $part nil? false = if
      $text $part concat text set
    end
  ] $body ai_sse_json_events each drop
  $text
end

( errorMap -> Result ) ai_error_result function
  errorMap var
  $errorMap "kind" at kind var
  $errorMap "message" at message var
  $kind $message fail result var
  $result error richError var
  $richError "provider" $errorMap "provider" at put drop
  $richError "status" $errorMap "status" at put drop
  $richError "raw" $errorMap "raw" at put drop
  $result
end

( status -> Bool ) ai_http_success_status? function
  status var
  $status nil? if
    false
  else
    $status 200 >= $status 299 <= and
  end
end

( status -> String ) ai_openai_error_kind function
  status var
  $status nil? if
    "unknown"
  else
    $status 429 = if
      "rate_limit"
    else
      $status 408 = if
        "timeout"
      else
        $status 409 = $status 425 = or if
          "transient"
        else
          $status 401 = $status 403 = or if
            "auth"
          else
            $status 500 >= $status 599 <= and if
              "server_error"
            else
              $status 400 >= $status 499 <= and if
                "validation"
              else
                "unknown"
              end
            end
          end
        end
      end
    end
  end
end

( response -> Result ) ai_openai_response_body_json function
  response var
  $response "body" at body var
  $body nil? if
    "AiProviderMalformedResponse" "AI provider response is missing body" fail
  else
    $body json_decode decoded var
    $decoded ok? if
      $decoded value ok
    else
      "AiProviderMalformedResponse" "AI provider response body is not valid JSON" fail
    end
  end
end

( argumentsValue -> Result ) ai_openai_tool_arguments function
  argumentsValue var
  $argumentsValue nil? if
    args map
    $args ok
  else
    $argumentsValue type "string" = if
      $argumentsValue json_decode decoded var
      $decoded ok? if
        $decoded value ok
      else
        "AiProviderMalformedToolCall" "OpenAI tool call arguments are not valid JSON" fail
      end
    else
      $argumentsValue type "map" = if
        $argumentsValue ok
      else
        "AiProviderMalformedToolCall" "OpenAI tool call arguments must be a JSON object string or map" fail
      end
    end
  end
end

( message -> Result ) ai_openai_message_tool_calls function
  message var
  toolCalls array
  $message "tool_calls" at rawToolCalls var
  $rawToolCalls nil? if
    $toolCalls ok
  else
    nil finalResult var
    0 index var
    $rawToolCalls count total var

    $index $total < while
      $rawToolCalls $index at rawCall var
      $rawCall "id" at id var
      $rawCall "function" at functionMap var
      $functionMap nil? if
        "AiProviderMalformedToolCall" "OpenAI tool call is missing function metadata" fail finalResult set
        break
      end

      $functionMap "name" at name var
      $functionMap "arguments" at ai_openai_tool_arguments argumentsResult var
      $argumentsResult ok? if
        $toolCalls $id $name $argumentsResult value ai_tool_call push drop
        $index 1 + index set
      else
        $argumentsResult finalResult set
        break
      end
    end

    $finalResult nil? if
      $toolCalls ok
    else
      $finalResult
    end
  end
end

( provider request raw -> Result ) ai_openai_chat_response_from_json function
  raw var
  request var
  provider var
  $raw "choices" at choices var
  $choices nil? if
    "AiProviderMalformedResponse" "AI provider response is missing choices" fail
  else
    $choices first choice var
    $choice nil? if
      "AiProviderMalformedResponse" "AI provider response has no choices" fail
    else
      $choice "message" at message var
      $message nil? if
        "AiProviderMalformedResponse" "AI provider response is missing choices[0].message" fail
      else
        $message "content" at text var
        $text nil? if
          "" text set
        end
        $raw "model" at model var
        $model nil? if
          $request "model" at model set
        end
        $message ai_openai_message_tool_calls toolCallsResult var
        $toolCallsResult ok? if
          $provider $model $text $toolCallsResult value $raw ai_chat_response ok
        else
          $toolCallsResult
        end
      end
    end
  end
end

( provider request response -> Result ) ai_openai_http_response_to_result function
  response var
  request var
  provider var
  $response "status" at status var
  $status ai_http_success_status? if
    $response ai_openai_response_body_json decoded var
    $decoded ok? if
      $provider $request $decoded value ai_openai_chat_response_from_json
    else
      $decoded
    end
  else
    $status ai_openai_error_kind kind var
    "AI provider returned status " $status to_string concat message var
    $provider $kind $message $status $response ai_error ai_error_result
  end
end

( request executorBlock -> Result ) ai_openai_execute_chat function
  executorBlock var
  request var
  $request "provider" at provider var
  $request "retry" at retryPolicy var
  1 maxAttempts var
  $retryPolicy nil? false = if
    $retryPolicy "max_attempts" at maxAttemptsValue var
    $maxAttemptsValue nil? false = if
      $maxAttemptsValue maxAttempts set
    end
  end
  $maxAttempts 0 > not if
    1 maxAttempts set
  end

  1 attempt var
  nil finalResult var

  $attempt $maxAttempts > not while
    $request $attempt $executorBlock call drop transportResult var
    nil result var
    $transportResult ok? if
      $provider $request $transportResult value ai_openai_http_response_to_result result set
    else
      $transportResult result set
    end

    $result ok? if
      $result finalResult set
      break
    end

    $result error errorMap var
    $errorMap ai_retryable_error? retryable var
    $attempt $maxAttempts < attemptsRemain var

    $retryable $attemptsRemain and if
      $attempt $retryPolicy ai_retry_delay_ms delayMs var
      $delayMs 0 > if
        $delayMs sleep
      end
      $attempt 1 + attempt set
      continue
    end

    $result finalResult set
    break
  end

  $finalResult
end

( baseUrl model -> Map ) ai_anthropic_provider function
  model var
  baseUrl var
  "anthropic" $baseUrl $model ai_provider
end

( model messages maxTokens stream -> Map ) ai_anthropic_messages_body function
  stream var
  maxTokens var
  messages var
  model var
  body map
  providerMessages array
  "" systemText var

  [
    message var
    $message "role" at "system" = if
      $message "content" at content var
      $content nil? false = if
        $systemText length 0 = if
          $content systemText set
        else
          $systemText "\n\n" concat $content concat systemText set
        end
      end
    else
      $providerMessages $message push drop
    end
  ] $messages each drop

  $body "model" $model put drop
  $body "max_tokens" $maxTokens put drop
  $body "messages" $providerMessages put drop
  $body "stream" $stream put drop
  $systemText length 0 > if
    $body "system" $systemText put drop
  end
  $body
end

( model messages maxTokens -> Map ) ai_anthropic_chat_body function
  maxTokens var
  messages var
  model var
  $model $messages $maxTokens false ai_anthropic_messages_body
end

( model messages maxTokens -> Map ) ai_anthropic_chat_stream_body function
  maxTokens var
