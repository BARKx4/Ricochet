  maxTokens var
  messages var
  model var
  version var
  token var
  baseUrl var
  $model $messages $maxTokens ai_anthropic_chat_body body var
  "POST" $baseUrl "/messages" concat http_request_new value request var
  $request "x-api-key" $token http_header_put value request set
  $request "anthropic-version" $version http_header_put value request set
  $request "Content-Type" "application/json" http_header_put value request set
  $request $body http_json_body value request set
  $request
end

