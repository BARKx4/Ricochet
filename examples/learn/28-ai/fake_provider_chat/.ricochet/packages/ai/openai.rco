( provider request raw -> Result ) ai_ollama_chat_response_from_json function
  raw var
  request var
  provider var
  $raw "message" at message var
  $message nil? if
    "AiProviderMalformedResponse" "Ollama response is missing message" fail
  else
    $message "content" at text var
    $text nil? if
      "" text set
    end
    $raw "model" at model var
    $model nil? if
      $request "model" at model set
    end
    toolCalls array
    $provider $model $text $toolCalls $raw ai_chat_response ok
  end
end

