( contentBlocks -> String ) ai_anthropic_content_text function
  contentBlocks var
  "" text var
  $contentBlocks nil? if
    $text
  else
    [
      block var
      $block "type" at "text" = if
        $block "text" at part var
        $part nil? false = if
          $text $part concat text set
        end
      end
    ] $contentBlocks each drop
    $text
  end
end

( contentBlocks -> Result ) ai_anthropic_content_tool_calls function
  contentBlocks var
  toolCalls array
  $contentBlocks nil? if
    $toolCalls ok
  else
    nil finalResult var
    0 index var
    $contentBlocks count total var

    $index $total < while
      $contentBlocks $index at block var
      $block "type" at "tool_use" = if
        $block "id" at id var
        $block "name" at name var
        $block "input" at input var

        $id nil? $name nil? or if
          "AiProviderMalformedToolCall" "Anthropic tool use block is missing id or name" fail finalResult set
          break
        end

        $input nil? if
          args map
          $toolCalls $id $name $args ai_tool_call push drop
        else
          $input type "map" = if
            $toolCalls $id $name $input ai_tool_call push drop
          else
            "AiProviderMalformedToolCall" "Anthropic tool use input must be a map" fail finalResult set
            break
          end
        end
      end
      $index 1 + index set
    end

    $finalResult nil? if
      $toolCalls ok
    else
      $finalResult
    end
  end
end

( provider request raw -> Result ) ai_anthropic_chat_response_from_json function
  raw var
  request var
  provider var
  $raw "content" at contentBlocks var
  $contentBlocks nil? if
    "AiProviderMalformedResponse" "Anthropic response is missing content" fail
  else
    $contentBlocks ai_anthropic_content_text text var
    $raw "model" at model var
    $model nil? if
      $request "model" at model set
    end
    $contentBlocks ai_anthropic_content_tool_calls toolCallsResult var
    $toolCallsResult ok? if
      $provider $model $text $toolCallsResult value $raw ai_chat_response ok
    else
      $toolCallsResult
    end
  end
end

( provider request response -> Result ) ai_anthropic_http_response_to_result function
  response var
  request var
  provider var
  $response "status" at status var
  $status ai_http_success_status? if
    $response ai_openai_response_body_json decoded var
    $decoded ok? if
      $provider $request $decoded value ai_anthropic_chat_response_from_json
    else
      $decoded
    end
  else
    $status ai_openai_error_kind kind var
    "AI provider returned status " $status to_string concat message var
    $provider $kind $message $status $response ai_error ai_error_result
  end
end

( request executorBlock -> Result ) ai_anthropic_execute_chat function
  executorBlock var
  request var
  $request "provider" at provider var
  $request "retry" at retryPolicy var
  1 maxAttempts var
  $retryPolicy nil? false = if
    $retryPolicy "max_attempts" at maxAttemptsValue var
    $maxAttemptsValue nil? false = if
      $maxAttemptsValue maxAttempts set
    end
  end
  $maxAttempts 0 > not if
    1 maxAttempts set
  end

  1 attempt var
  nil finalResult var

  $attempt $maxAttempts > not while
    $request $attempt $executorBlock call drop transportResult var
    nil result var
    $transportResult ok? if
      $provider $request $transportResult value ai_anthropic_http_response_to_result result set
    else
      $transportResult result set
    end

    $result ok? if
      $result finalResult set
      break
    end

    $result error errorMap var
    $errorMap ai_retryable_error? retryable var
    $attempt $maxAttempts < attemptsRemain var

    $retryable $attemptsRemain and if
      $attempt $retryPolicy ai_retry_delay_ms delayMs var
      $delayMs 0 > if
        $delayMs sleep
      end
      $attempt 1 + attempt set
      continue
    end

    $result finalResult set
    break
  end

  $finalResult
end

