      $provider $request $decoded value ai_ollama_chat_response_from_json
    else
      $decoded
    end
  else
    $status ai_openai_error_kind kind var
    "AI provider returned status " $status to_string concat message var
    $provider $kind $message $status $response ai_error ai_error_result
  end
end

( request executorBlock -> Result ) ai_ollama_execute_chat function
  executorBlock var
  request var
  $request "provider" at provider var
  $request "retry" at retryPolicy var
  1 maxAttempts var
  $retryPolicy nil? false = if
    $retryPolicy "max_attempts" at maxAttemptsValue var
    $maxAttemptsValue nil? false = if
      $maxAttemptsValue maxAttempts set
    end
  end
  $maxAttempts 0 > not if
    1 maxAttempts set
  end

  1 attempt var
  nil finalResult var

  $attempt $maxAttempts > not while
    $request $attempt $executorBlock call drop transportResult var
    nil result var
    $transportResult ok? if
      $provider $request $transportResult value ai_ollama_http_response_to_result result set
    else
      $transportResult result set
    end

    $result ok? if
      $result finalResult set
      break
    end

    $result error errorMap var
    $errorMap ai_retryable_error? retryable var
    $attempt $maxAttempts < attemptsRemain var

    $retryable $attemptsRemain and if
      $attempt $retryPolicy ai_retry_delay_ms delayMs var
      $delayMs 0 > if
        $delayMs sleep
      end
      $attempt 1 + attempt set
      continue
    end

    $result finalResult set
    break
  end

  $finalResult
end

( event -> String ) ai_ollama_stream_delta function
  event var
  $event "message" at message var
  $message nil? if
    nil
  else
    $message "content" at
  end
end

( body -> Result ) ai_ollama_stream_events function
  body var
  events array
  $body lines bodyLines var
  nil finalResult var
  0 index var
  $bodyLines count total var

  $index $total < while
    $bodyLines $index at trim data var
    $data length 0 = if
      $index 1 + index set
      continue
    end

    $data json_decode decoded var
    $decoded ok? if
      $decoded value rawEvent var
      $rawEvent ai_ollama_stream_delta part var
      $part nil? false = if
        $events "delta" $part $index false ai_stream_event push drop
      end
      $rawEvent "done" at true = if
        $events "done" nil $index true ai_stream_event push drop
      end
      $index 1 + index set
    else
      "AiProviderMalformedEvent" "Ollama stream event is not valid JSON" fail finalResult set
      break
    end
  end

  $finalResult nil? if
    $events ok
  else
    $finalResult
  end
end

( event -> String ) ai_anthropic_stream_delta function
  event var
  $event "type" at "content_block_delta" = if
    $event "delta" at delta var
    $delta nil? if
      nil
    else
      $delta "type" at "text_delta" = if
        $delta "text" at
      else
        nil
      end
    end
  else
    nil
  end
end

( body -> Result ) ai_anthropic_stream_events function
  body var
  events array
  $body ai_sse_data_lines dataLines var
  nil finalResult var
  0 index var
  $dataLines count total var

  $index $total < while
    $dataLines $index at data var
    $data json_decode decoded var
    $decoded ok? if
      $decoded value rawEvent var
      $rawEvent "type" at eventType var

      $eventType "content_block_delta" = if
        $rawEvent "delta" at delta var
        $delta nil? false = if
          $delta "type" at deltaType var
          $deltaType "text_delta" = if
            $delta "text" at part var
            $part nil? false = if
              $events "delta" $part $index false ai_stream_event push drop
            end
          else
            $deltaType "input_json_delta" = if
              $delta "partial_json" at partial var
              $partial nil? false = if
                $events "tool_delta" $partial $index false ai_stream_event push drop
              end
            else
              $deltaType "thinking_delta" = if
                $delta "thinking" at thought var
                $thought nil? false = if
                  $events "thinking_delta" $thought $index false ai_stream_event push drop
                end
              end
            end
          end
        end
      else
        $eventType "message_stop" = if
          $events "done" nil $index true ai_stream_event push drop
        else
          $eventType "error" = if
            $rawEvent "error" at errorMap var
            "AiProviderStreamError" messageKind var
            "Anthropic stream returned an error event" message var
            $errorMap nil? false = if
              $errorMap "type" at errorType var
              $errorType nil? false = if
                $errorType messageKind set
              end
              $errorMap "message" at errorMessage var
              $errorMessage nil? false = if
                $errorMessage message set
              end
            end
            $messageKind $message fail finalResult set
            break
          end
        end
      end

      $index 1 + index set
    else
      "AiProviderMalformedEvent" "Anthropic stream event is not valid JSON" fail finalResult set
      break
    end
  end

  $finalResult nil? if
    $events ok
  else
    $finalResult
  end
end

( body -> Result ) ai_openai_stream_events function
  body var
  events array
  $body ai_sse_data_lines dataLines var
  nil finalResult var
  0 index var
  $dataLines count total var

  $index $total < while
    $dataLines $index at data var
    $data "[DONE]" = if
      $events "done" nil $index true ai_stream_event push drop
      $index 1 + index set
    else
      $data json_decode decoded var
      $decoded ok? if
        $decoded value rawEvent var
        $rawEvent ai_openai_stream_delta part var
        $events "delta" $part $index false ai_stream_event push drop
        $index 1 + index set
      else
        "AiProviderMalformedEvent" "AI stream event is not valid JSON" fail finalResult set
        break
      end
    end
  end

  $finalResult nil? if
    $events ok
  else
    $finalResult
  end
end

( state read -> Result ) ai_openai_stream_read_events function
  read var
  state var
  $state "buffer" at buffer var
  $buffer nil? if
    "" buffer set
  end
  $read ai_stream_read_body body var
  $buffer $body concat combined var
  $combined ai_sse_complete_body split var
  $read ai_stream_read_done httpDone var
  $split "body" at $split "buffer" at $httpDone ai_stream_flush_buffer_if_done flushed var
  $flushed "body" at completeBody var
  $flushed "buffer" at nextBuffer var

  $completeBody length 0 > if
    $completeBody ai_openai_stream_events parsed var
  else
    events array
    $events ok parsed var
  end

  $parsed ok? if
    $parsed value events var
    $state "buffer" $nextBuffer put drop
    $state $read $events ai_stream_commit_read drop
    $state $events ai_stream_read_event_result ok
  else
    $parsed
  end
end

