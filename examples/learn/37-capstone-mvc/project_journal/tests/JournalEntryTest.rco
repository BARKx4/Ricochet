JournalEntryTest TestCase Subclass
  [
    JournalEntry new
    "Manual outline" swap title.set
    "published" swap status.set
    label
    "Manual outline [published]" assert_equals
  ] "testEntryLabel" Method

  [
    entries array
    JournalEntry new
    "TUI smoke test" swap title.set
    "draft" swap status.set
    $entries swap push! drop

    $entries count
    1 assert_equals
  ] "testEntriesCollection" Method
end
