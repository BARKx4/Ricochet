NotesController Controller Subclass
  ( ctx -> Response ) [
    ctx var
    20 Note limit
    dup ok? if
      value notes var
      $notes count noteCount var
      $notes first firstNote var
      $firstNote nil? if
        "No notes yet" firstTitle var
      else
        $firstNote "title" at firstTitle var
      end
      "Ricochet Notes" title var
      $ctx
      "notes/index" swap view
    else
      error "message" at text 500 status
    end
  ] "index" Method
  ( title body -> Response ) [
    body var
    title var
    $title nil? if
      "Title is required" text 400 status
    else
      $title blank? if
        "Title is required" text 400 status
      else
        note map
        $note "title" $title put drop
        $note "body" $body put drop
        $note "status" "open" put drop
        $note Note insert
        dup ok? if
          drop
          "/" redirect
        else
          error "message" at text 500 status
        end
      end
    end
  ] "create" Method
end
