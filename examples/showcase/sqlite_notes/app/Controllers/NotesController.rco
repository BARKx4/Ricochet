NotesController Controller Subclass
  ( ctx -> Response ) [
    ctx var
    20 Note limit
    dup ok? if
      value notes var
      notes get count noteCount var
      notes get first firstNote var
      firstNote get nil? if
        "No notes yet" firstTitle var
      else
        firstNote get "title" at firstTitle var
      end
      "Ricochet Notes" title var
      ctx get
      "notes/index" swap view
    else
      error "message" at text 500 status
    end
  ] "index" Method
  ( title body -> Response ) [
    body var
    title var
    title get nil? if
      "Title is required" text 400 status
    else
      title get blank? if
        "Title is required" text 400 status
      else
        note map
        note get "title" title get put! drop
        note get "body" body get put! drop
        note get "status" "open" put! drop
        note get Note insert
        dup ok? if
          drop
          "/" redirect
        else
          error "message" at text 500 status
        end
      end
    end
  ] "create" Method
end
