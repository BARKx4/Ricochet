"ai/openai" import

"OPENAI_API_KEY" secret_env secret_resolve value token var

message map

$message "role" "user" put! drop

$message "content" "Return the word ricochet." put! drop

messages array

$messages $message push! drop

"https://api.openai.com/v1" $token "gpt-4.1-mini" $messages ai_openai_chat_request request var

hosts array

$hosts "api.openai.com" push! drop

$request "allowed_hosts" $hosts put! drop

schemes array

$schemes "https" push! drop

$request "allowed_schemes" $schemes put! drop

$request 30000 http_timeout value request set

$request "max_response_bytes" 1048576 put! drop

$request http_request value ai_response_summary json-encode println
