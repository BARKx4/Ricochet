"ai/openai" import

"OPENAI_API_KEY" ai_secret_ref apiKeyRef var

message map

message get "role" "user" put! drop

message get "content" "Return a short Ricochet readiness probe." put! drop

messages array

messages get message get push! drop

"https://api.openai.com/v1" "dry-run-token" "gpt-4.1-mini" messages get ai_openai_chat_request request var

hosts array

hosts get "api.openai.com" push! drop

request get "allowed_hosts" hosts get put! drop

schemes array

schemes get "https" push! drop

request get "allowed_schemes" schemes get put! drop

request get 30000 http_timeout value request set

request get "max_response_bytes" 1048576 put! drop

request get "api_key_ref" apiKeyRef get put! drop

request get "method" at "POST" assert-equals

request get "api_key_ref" at "name" at "OPENAI_API_KEY" assert-equals

request get json-encode println
