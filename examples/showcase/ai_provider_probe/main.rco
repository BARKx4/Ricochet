"ai/openai" import

"OPENAI_API_KEY" ai_secret_ref apiKeyRef var

message map

$message "role" "user" put! drop

$message "content" "Return a short Ricochet readiness probe." put! drop

messages array

$messages $message push! drop

"https://api.openai.com/v1" "dry-run-token" "gpt-4.1-mini" $messages ai_openai_chat_request request var

hosts array

$hosts "api.openai.com" push! drop

$request "allowed_hosts" $hosts put! drop

schemes array

$schemes "https" push! drop

$request "allowed_schemes" $schemes put! drop

$request 30000 http_timeout value request set

$request "max_response_bytes" 1048576 put! drop

$request "api_key_ref" $apiKeyRef put! drop

$request "method" at "POST" assert_equals

$request "api_key_ref" at "name" at "OPENAI_API_KEY" assert_equals

$request json_encode println
