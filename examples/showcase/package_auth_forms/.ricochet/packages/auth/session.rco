(( Session and route guard helpers for trusted local Ricochet MVC apps. ))
( session -> Bool ) auth_user_present function
  session var
  $session "user_id" has?
end

( session redirectPath -> Map ) auth_route_guard function
  redirectPath var
  session var
  guard map
  $session auth_user_present ok var
  $guard "ok" $ok put! drop
  $ok if
    $guard "redirect" nil put! drop
    $guard "reason" nil put! drop
  else
    $guard "redirect" $redirectPath put! drop
    $guard "reason" "missing_user_session" put! drop
  end
  $guard
end

( session -> String ) auth_csrf_token function
  session var
  $session "csrf_token" has? if
    $session "csrf_token" at
  else
    ""
  end
end

( session submittedToken -> Bool ) auth_csrf_valid function
  submittedToken var
  session var
  $session auth_csrf_token storedToken var
  $storedToken blank? if
    false
  else
    $submittedToken blank? if
      false
    else
      $storedToken $submittedToken =
    end
  end
end

( session submittedToken -> Map ) auth_csrf_check function
  submittedToken var
  session var
  check map
  $session $submittedToken auth_csrf_valid ok var
  $check "ok" $ok put! drop
  $ok if
    $check "reason" nil put! drop
  else
    $check "reason" "invalid_csrf_token" put! drop
  end
  $check
end

( userId csrfToken -> Map ) auth_session_for_user function
  csrfToken var
  userId var
  session map
  $session "user_id" $userId put! drop
  $session "csrf_token" $csrfToken put! drop
  $session "authenticated" true put! drop
  $session
end

( -> Map ) auth_secure_cookie_options function
  options map
  $options "http_only" true put! drop
  $options "same_site" "Lax" put! drop
  $options "secure" true put! drop
  $options
end

( name -> Map ) auth_extension_point function
  name var
  extension map
  $extension "package" "@ricochet/auth" put! drop
  $extension "name" $name put! drop
  $extension "stable" false put! drop
  $extension
end
