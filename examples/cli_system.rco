(( Run with: rco run examples/cli_system.rco alpha beta ))

"argc=" print
args .count println

"cwd=" print
cwd value println

"now=" print
now println

"random=" print
100 random println

"Cargo.toml bytes=" print
"Cargo.toml" fs .read-text value .count println

"PATH" env dup ok? if
  "path-present" println
  value drop
else
  error .message get eprint
end
