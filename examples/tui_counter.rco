(( Preview with: rco tui examples/tui_counter.rco ))
(( Package with: rco package examples/tui_counter.rco --tui --output tui-counter.exe ))
(( Use --output tui-counter on Linux/macOS. ))

0 count var

tui .enter! value drop
tui .clear! value drop

true while
  0 0 tui .move-to! value drop
  "Ricochet TUI beta" tui .write! value drop
  0 2 tui .move-to! value drop
  "Count: " tui .write! value drop
  count get to-string tui .write! value drop
  0 4 tui .move-to! value drop
  "Press + to increment, - to decrement, q or Escape to quit." tui .write! value drop
  tui .flush! value drop

  tui .read-key value key var
  "char" $key .at "+" = if
    count get 1 + count set
  end
  "char" $key .at "-" = if
    count get 1 - count set
  end
  "char" $key .at "q" = if
    break
  end
  "code" $key .at "escape" = if
    break
  end
end

tui .leave! value drop
