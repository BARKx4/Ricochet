(( Preview with: rco tui examples/tui_counter.rco ))
(( Package with: rco package examples/tui_counter.rco --tui --output tui-counter.exe ))
(( Use --output tui-counter on Linux/macOS. ))

0 count var

tui_enter value drop
tui_clear value drop

true while
  0 0 tui_move_to value drop
  "Ricochet TUI beta" tui_write value drop
  0 2 tui_move_to value drop
  "Count: " tui_write value drop
  count get to-string tui_write value drop
  0 4 tui_move_to value drop
  "Press + to increment, - to decrement, q or Escape to quit." tui_write value drop
  tui_flush value drop

  tui_read_key value key var
  $key "char" at "+" = if
    count get 1 + count set
  end
  $key "char" at "-" = if
    count get 1 - count set
  end
  $key "char" at "q" = if
    break
  end
  $key "code" at "escape" = if
    break
  end
end

tui_leave value drop
