(( Preview with: rco gui examples/webview_ui.rco ))
(( Package with: rco package examples/webview_ui.rco --gui --output webview-ui.exe ))
(( Use --output webview-ui on Linux/macOS. ))
( state event -> Map ) save_profile function
  event var
  state var
  actions array
  actions get "Save" "save-profile" "save_profile" webview_action push! drop
  "Saved profile for " state get "name" at concat webview_text saved var
  "Ricochet Desktop UI" saved get state get actions get webview_window_state value
end

"Ricochet Desktop UI" 1 webview_heading heading var

"Name" "Ada" webview_input nameInput var

"Save" "save-profile" webview_button saveButton var

state map

state get "name" "Ada" put! drop

actions array

actions get "Save" "save-profile" "save_profile" webview_action push! drop

"<main>" $heading concat

$nameInput concat

$saveButton concat

"</main>" concat body var

"Ricochet Desktop UI" $body state get actions get webview_window_state value document var
