(( Preview with: rco gui examples/webview_ui.rco ))
(( Package with: rco package examples/webview_ui.rco --gui --output webview-ui.exe ))
(( Use --output webview-ui on Linux/macOS. ))

"Ricochet Desktop UI" 1 webview_heading heading var
"Name" "Ada" webview_input nameInput var
"Save" "save-profile" webview_button saveButton var

"<main>" $heading concat
$nameInput concat
$saveButton concat
"</main>" concat body var

"Ricochet Desktop UI" $body webview_window value document var
