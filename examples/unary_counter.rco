(( Heap-allocated object chains provide counters beyond fixed-width integers. ))

Counter Object Subclass
  "previous" Accessor
end

nil counter var
0 steps var

$counter Counter new previous.set counter set
$counter Counter new previous.set counter set
$counter Counter new previous.set counter set

$counter nil? false = while
  $counter previous.get counter set
  $steps 1 + steps set
end

$steps println
