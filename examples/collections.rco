(( Run with: rco run examples/collections.rco ))

users array
$users "Ada" push! drop
$users "Grace" push! drop
$users 1 "Lin" insert! drop
$users 1 remove-at! drop

settings map
$settings "theme" "dark" put! drop

0 6 range numbers var
[ 2 * ] $numbers transform doubled var
[ 4 > ] $doubled select selected var

"users:" println
$users count println
$users 0 at println
$users ", " join println

"settings:" println
$settings "theme" at println
$settings keys count println

"numbers:" println
0 [ + ] $selected reduce println
[ 10 = ] $doubled any? println
[ 2 > ] $doubled all? println
[ 8 = ] $doubled find println

queue list
$queue 1 push! drop
$queue 2 push! drop
$queue count println

tags Set
$tags "rco" push! drop
$tags "rco" push! drop
$tags count println
