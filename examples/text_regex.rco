(( Run with: rco run examples/text_regex.rco ))

"text:" println
"ricochet" 2 4 slice println
"  Ada" trim-start println
"cat" chars "," join println

"regex:" println
"\\d+" regex value digits var
"abc123def456" $digits find "text" at println
$digits "abc123def456" "#" replace println

"collections:" println
names array
$names "Ada" push! drop
$names "Grace" push! drop
$names "Lin" push! drop
$names 2 take "," join println
$names 1 skip "," join println

"inspect:" println
bag map
$bag "name" "Ada" put! drop
$bag inspect println
$bag count println
