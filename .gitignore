target/
dist/
hosts/**/bin/
hosts/**/obj/
.serena/
.superpowers/
**/*.rs.bk
*.pdb
*.profraw
__pycache__/
*.pyc

# Example applications create local SQLite state when their database-backed
# tests or servers start. Keep that generated state out of source control.
examples/**/db/*.sqlite3
examples/**/db/*.sqlite3-*

.env
.env.*
!.env.example

# Markdown is agent/source data unless it is a conventional README. Public-facing
# docs should be committed as pre-rendered HTML; keep non-README *.md files
# local/ignored by default.
*.md
**/*.md
!README.md
!**/README.md
!SECURITY.md
!SUPPORT.md

# Keep the source-controlled portable-pty patch auditable while ignoring files
# generated when its standalone crate tests are run directly.
!third_party/portable-pty/LICENSE.md
!third_party/portable-pty/RICOCHET-PATCH.md
third_party/portable-pty/Cargo.lock
